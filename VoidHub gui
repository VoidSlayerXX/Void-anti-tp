local ClientGrabReversal = {
    -- Real server hook handles reversal. Keep this local fallback OFF so
    -- outgoing grabs cannot drag the local player into the void.
    Enabled = false,
    LastCheck = 0,
    CheckInterval = 0.1,
    LastReversal = 0,
    ReversalCooldown = 0.5
}

local GRAB_STATE_NAMES = {
    Grabbed = true,
    IsGrabbed = true,
    BeingGrabbed = true,
    Carried = true,
    IsCarried = true,
    BeingCarried = true,
    Held = true,
    IsHeld = true
}

local GRAB_NAME_WORDS = {
    "grab",
    "carry",
    "carried",
    "hold",
    "held",
    "drag"
}

local function nameLooksLikeGrab(name)
    local lower = string.lower(tostring(name))
    for _, word in ipairs(GRAB_NAME_WORDS) do
        if string.find(lower, word, 1, true) then
            return true
        end
    end
    return false
end

local function findGrabberClient()
    local c = character()
    if not c then return nil end
    
    -- Check attributes
    for attributeName in pairs(GRAB_STATE_NAMES) do
        if Player:GetAttribute(attributeName) == true or c:GetAttribute(attributeName) == true then
            -- Find nearest player
            local myRoot = root()
            if myRoot then
                local closest
                local closestDist = 15
                for _, otherPlayer in ipairs(Players:GetPlayers()) do
                    if otherPlayer ~= Player then
                        local otherRoot = root(otherPlayer)
                        if otherRoot then
                            local dist = (otherRoot.Position - myRoot.Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = otherPlayer
                            end
                        end
                    end
                end
                if closest then
                    return closest
                end
            end
        end
    end
    
    -- Check for external welds/constraints
    for _, object in ipairs(c:GetDescendants()) do
        if nameLooksLikeGrab(object.Name) or object:IsA("WeldConstraint") or object:IsA("Weld") or object:IsA("RopeConstraint") then
            -- Check if connects to another character
            local connectedPlayer = nil
            
            if object:IsA("WeldConstraint") then
                local part0 = object.Part0
                local part1 = object.Part1
                if part0 and part1 then
                    for _, otherPlayer in ipairs(Players:GetPlayers()) do
                        if otherPlayer ~= Player and otherPlayer.Character then
                            if part0:IsDescendantOf(otherPlayer.Character) or part1:IsDescendantOf(otherPlayer.Character) then
                                connectedPlayer = otherPlayer
                                break
                            end
                        end
                    end
                end
            elseif object:IsA("Weld") then
                local part0 = object.Part0
                local part1 = object.Part1
                if part0 and part1 then
                    for _, otherPlayer in ipairs(Players:GetPlayers()) do
                        if otherPlayer ~= Player and otherPlayer.Character then
                            if part0:IsDescendantOf(otherPlayer.Character) or part1:IsDescendantOf(otherPlayer.Character) then
                                connectedPlayer = otherPlayer
                                break
                            end
                        end
                    end
                end
            end
            
            if connectedPlayer then
                return connectedPlayer
            end
        end
    end
    
    return nil
end

local function clientTeleportGrabberToVoid(grabber)
    if not grabber then return false end
    
    local grabberRoot = root(grabber)
    if not grabberRoot then return false end
    
    local now = os.clock()
    if now - ClientGrabReversal.LastReversal < ClientGrabReversal.ReversalCooldown then
        return false
    end
    ClientGrabReversal.LastReversal = now
    
    -- Teleport grabber to void
    local voidPosition = Vector3.new(
        grabberRoot.Position.X,
        workspace.FallenPartsDestroyHeight - 50,
        grabberRoot.Position.Z
    )
    
    grabberRoot.CFrame = CFrame.new(voidPosition)
    grabberRoot.AssemblyLinearVelocity = Vector3.zero
    grabberRoot.Velocity = Vector3.zero
    
    -- Clear grab state on self
    local c = character()
    if c then
        for attributeName in pairs(GRAB_STATE_NAMES) do
            Player:SetAttribute(attributeName, false)
            c:SetAttribute(attributeName, false)
        end
    end
    
    return true
end

-- Client-side grab reversal loop
RunService.Heartbeat:Connect(function(dt)
    if not ClientGrabReversal.Enabled then return end
    
    ClientGrabReversal.LastCheck += dt
    if ClientGrabReversal.LastCheck < ClientGrabReversal.CheckInterval then return end
    ClientGrabReversal.LastCheck = 0
    
    local grabber = findGrabberClient()
    if grabber then
        clientTeleportGrabberToVoid(grabber)
    end
end)


local function corner(o, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = o
    return c
end

local function stroke(o, transparency, thickness, color)
    local s = Instance.new("UIStroke")
    s.Transparency = transparency or 0.5
    s.Thickness = thickness or 1
    s.Color = color or Color3.fromRGB(90, 110, 220)
    s.Parent = o
    return s
end

