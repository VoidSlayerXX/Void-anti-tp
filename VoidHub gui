function Extra.switchFarmTarget()

    if not State.AutoFarm
        or Extra.AutoFarmSwitching then

        return false
    end

    Extra.AutoFarmSwitching =
        true

    if State.KillAura
        and Extra.setKillAuraEnabled then

        Extra.setKillAuraEnabled(
            false
        )
    end

    local nextTarget =
        Extra.pickNextFarmTarget()

    if nextTarget then

        selectPlayer(
            nextTarget
        )

        PvPStatus.Text =
            "STATUS • AUTO FARM TARGET • "
            .. nextTarget.Name

        task.delay(
            0.2,
            function()

                Extra.AutoFarmSwitching =
                    false

                if State.AutoFarm
                    and Extra.setKillAuraEnabled then

                    Extra.setKillAuraEnabled(
                        true
                    )
                end
            end
        )

        return true
    end

    Extra.AutoFarmSwitching =
        false

    PvPStatus.Text =
        "STATUS • AUTO FARM • WAITING FOR TARGET"

    return false
end

function Extra.performAutoClick()

    if UIS:GetFocusedTextBox() then

        return true
    end

    local camera =
        workspace.CurrentCamera

    local clickPosition

    if camera then

        clickPosition =
            Vector2.new(
                camera.ViewportSize.X
                    * 0.5,
                camera.ViewportSize.Y
                    * 0.5
            )

    else

        clickPosition =
            UIS:GetMouseLocation()
    end

    local ok =
        pcall(function()

            local VirtualInputManager =
                game:GetService(
                    "VirtualInputManager"
                )

            VirtualInputManager:SendMouseButtonEvent(
                clickPosition.X,
                clickPosition.Y,
                0,
                true,
                game,
                0
            )

            VirtualInputManager:SendMouseButtonEvent(
                clickPosition.X,
                clickPosition.Y,
                0,
                false,
                game,
                0
            )
        end)

    if ok then

        return true
    end

    local fallbackOk =
        pcall(function()

            local VirtualUser =
                game:GetService(
                    "VirtualUser"
                )

            VirtualUser:CaptureController()

            VirtualUser:Button1Down(
                clickPosition,
                camera
                    and camera.CFrame
                    or CFrame.new()
            )

            VirtualUser:Button1Up(
                clickPosition,
                camera
                    and camera.CFrame
                    or CFrame.new()
            )
        end)

    return fallbackOk
end

