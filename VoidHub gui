local function clanMatch(t)

    local q =
        string.upper(
            SelectedClan
        )

    return
        string.find(
            string.upper(
                t.Name
            ),
            q,
            1,
            true
        )
        or
        string.find(
            string.upper(
                t.DisplayName
            ),
            q,
            1,
            true
        )
end

local function nearestClan()

    local me =
        root()

    if not me then
        return nil, nil
    end

    local best =
        nil

    local dist =
        math.huge

    for _, t in ipairs(
        Players:GetPlayers()
    ) do

        if t ~= Player
            and clanMatch(
                t
            ) then

            local r =
                root(
                    t
                )

            if r then

                local d =
                    (
                        r.Position
                        - me.Position
                    ).Magnitude

                if d < dist then

                    best =
                        t

                    dist =
                        d
                end
            end
        end
    end

    return best,
        dist
end

