    for _, t in ipairs(
        Players:GetPlayers()
    ) do

        if t ~= Player then

            local r =
                root(
                    t
                )

            if r then

                local now =
                    os.clock()

                local d =
                    DetectorData[t]

                if d then

                    local dt =
                        math.max(
                            now - d.t,
                            0.01
                        )

                    local speed =
                        (
                            r.Position
                            - d.p
                        ).Magnitude
                        / dt

                    local status =
                        (
                            speed > 100
                            or r.AssemblyLinearVelocity.Magnitude > 130
                        )
                        and "UNUSUAL MOVEMENT"
                        or "NORMAL"

                    table.insert(
                        out,

                        t.Name
                        .. " • "
                        .. status
                        .. " • SPD "
                        .. math.floor(
                            speed
                        )
                    )
                end

                DetectorData[t] = {
                    p = r.Position,
                    t = now
                }
            end
        end
    end

    DetectorText.Text =
        #out > 0
        and table.concat(
            out,
            "\n"
        )
        or "Detector ready."
end

