                object
            )

                if not enabled
                    or not object then

                    return
                end

                if object:IsA(
                    "TextLabel"
                )
                    or object:IsA(
                        "TextButton"
                    )
                    or object:IsA(
                        "TextBox"
                    ) then

                    local okText,
                        value =
                        pcall(function()

                            return object.Text
                        end)

                    if okText
                        and isMatch(
                            value
                        ) then

                        registerTrigger(
                            value
                        )
                    end
                end
            end

            local function watchObject(
                object
            )

                if not object then
                    return
                end

                if not (
                    object:IsA(
                        "TextLabel"
                    )
                    or object:IsA(
                        "TextButton"
                    )
                    or object:IsA(
                        "TextBox"
                    )
                ) then

                    return
                end

                inspectObject(
                    object
                )

                if watchedConnections[
                    object
                ] then

                    return
                end

                local connection =
                    object:GetPropertyChangedSignal(
                        "Text"
                    ):Connect(function()

                        pcall(
                            inspectObject,
                            object
                        )
                    end)

                watchedConnections[
                    object
                ] =
                    connection

                object.Destroying:Connect(function()

                    local c =
                        watchedConnections[
                            object
                        ]

                    if c then

                        c:Disconnect()

                        watchedConnections[
                            object
                        ] =
                            nil
                    end
                end)
            end

            local function scanAll()

                for _,
                    object in ipairs(
                        PlayerGui:GetDescendants()
                    ) do

                    pcall(
                        watchObject,
                        object
                    )
                end
            end

            PlayerGui.DescendantAdded:Connect(function(
                object
            )

                task.defer(function()

                    pcall(
                        watchObject,
                        object
                    )
                end)
            end)

            toggleButton.Activated:Connect(function()

                enabled =
                    not enabled

                toggleButton.Text =
                    enabled
                    and "TRIGGER WATCH: ON"
                    or "TRIGGER WATCH: OFF"

                status.Text =
                    enabled
                    and "Status: ON • watching local GUI text"
                    or "Status: OFF"

                if enabled then

                    scanAll()
                end

                render()
            end)

            scanButton.Activated:Connect(function()

                scanAll()

                status.Text =
                    "Status: GUI SCAN COMPLETE"

                render()
            end)

            clearButton.Activated:Connect(function()

