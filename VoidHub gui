function Extra.findNearestSpawnCFrame(
    forceRefresh
)

    local now =
        os.clock()

    local myRoot =
        root()

    if not myRoot then

        return nil,
            nil
    end

    -- Refresh the actual SpawnLocation list only occasionally.
    -- Distance selection is still recalculated when needed, but this avoids
    -- scanning every descendant in the map over and over.
    if #Extra.SpawnCache == 0
        or now >=
            Extra.SpawnCacheRefreshAt then

        Extra.SpawnCache =
            {}

        for _, object in ipairs(
            workspace:GetDescendants()
        ) do

            if object:IsA(
                "SpawnLocation"
            ) then

                Extra.SpawnCache[
                    #Extra.SpawnCache + 1
                ] =
                    object
            end
        end

        Extra.SpawnCacheRefreshAt =
            now
            + 20
    end

    if forceRefresh ~= true
        and Extra.NearestSpawnCF
        and now <
            Extra.NearestSpawnRefreshAt then

        return
            Extra.NearestSpawnCF,
            Extra.NearestSpawnName
    end

    local bestSpawn
    local bestDistance =
        math.huge

    for _, object in ipairs(
        Extra.SpawnCache
    ) do

        if object
            and object.Parent
            and object:IsA(
                "SpawnLocation"
            ) then

            local distance =
                (
                    object.Position
                    - myRoot.Position
                ).Magnitude

            if distance <
                bestDistance then

                bestDistance =
                    distance

                bestSpawn =
                    object
            end
        end
    end

    if bestSpawn then

        Extra.NearestSpawnCF =
            bestSpawn.CFrame
            *
            CFrame.new(
                0,
                4,
                0
            )

        Extra.NearestSpawnName =
            bestSpawn.Name

        Extra.NearestSpawnRefreshAt =
            now
            + 2

        return
            Extra.NearestSpawnCF,
            Extra.NearestSpawnName
    end

    Extra.NearestSpawnCF =
        nil

    Extra.NearestSpawnName =
        nil

    Extra.NearestSpawnRefreshAt =
        now
        + 2

    return nil,
        nil
end


