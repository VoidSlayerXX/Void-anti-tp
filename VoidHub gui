            Extra.Resizing =
                true

            Extra.ResizeStartX =
                input.Position.X

            Extra.ResizeStartScale =
                Extra.UserScale
        end
    end)

    UIS.InputChanged:Connect(function(
        input
    )

        if not Extra.Resizing then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            local delta =
                (
                    input.Position.X
                    - Extra.ResizeStartX
                )
                / 470

            Extra.UserScale =
                math.clamp(
                    Extra.ResizeStartScale
                        + delta,
                    0.72,
                    1.35
                )

            updateScale()
        end
    end)

    UIS.InputEnded:Connect(function(
        input
    )

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            Extra.Resizing =
                false
        end
    end)
end

local PanelOpen = false
local PanelBusy = false

local function openPanel()

    if Extra.Unlocked ~= true then

        if Extra.AccessOverlay then
            Extra.AccessOverlay.Visible =
                true
        end

        return
    end

    if PanelBusy
        or PanelOpen then

        return
    end

    PanelBusy = true
    PanelOpen = true

    Gui.Enabled = true

    Holder.Visible = true
    Main.Visible = true
    Shadow.Visible = true

    PanelScale.Scale = 0.84

    local tw =
        TweenService:Create(
            PanelScale,
            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Scale = 1
            }
        )

    tw:Play()

    task.delay(
        0.24,
        function()
            PanelBusy = false
        end
    )
end

local function closePanel()
    if PanelBusy
        or not PanelOpen then

        return
    end

    PanelBusy = true
    PanelOpen = false

    local tw =
        TweenService:Create(
            PanelScale,
            TweenInfo.new(
                0.13,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),
            {
                Scale = 0.84
            }
        )

    tw:Play()

    task.delay(
        0.14,
        function()

            if not PanelOpen then
                Holder.Visible = false
            end

            PanelScale.Scale = 1
            PanelBusy = false
        end
    )
end

local function togglePanel()
    if PanelOpen then
        closePanel()
    else
        openPanel()
    end
end

