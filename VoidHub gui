local CollisionCache =
    {}

local function restoreCollision()

    for part, v in pairs(
        CollisionCache
    ) do

        if part.Parent then
            part.CanCollide =
                v
        end
    end

    CollisionCache =
        {}
end

local function applyInvisible()

    local c =
        character()

    if not c then
        return
    end

    for _, o in ipairs(
        c:GetDescendants()
    ) do

        if o:IsA(
            "BasePart"
        )
            and o.Name ~=
                "HumanoidRootPart" then

            o.LocalTransparencyModifier =
                State.Invisible
                and 1
                or 0
        end
    end
end

