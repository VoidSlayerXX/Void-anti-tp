end

local function refreshSafe()

    local cf =
        activeSafe()

    local spawnCF,
        spawnName =
        Extra.findNearestSpawnCFrame(
            false
        )

    if not cf then

        SafePositionText.Text =
            "Safe Position: NOT SET"

        if not SafeEscaped then

            SafeState.Text =
                "State: SEARCHING FOR NEAREST SPAWN"
        end

        SafeDash.Text =
            "Safe Escape: NO SAFE POINT"

        return
    end

    local v =
        cf.Position

    SafePositionText.Text =
        string.format(
            "Safe Position: %s • %d, %d, %d",

            spawnCF
            and (
                "NEAREST SPAWN"
                .. (
                    spawnName
                    and (
                        " • "
                        .. spawnName
                    )
                    or ""
                )
            )
            or safeSource(),

            math.floor(
                v.X
            ),

            math.floor(
                v.Y
            ),

            math.floor(
                v.Z
            )
        )

    if not SafeEscaped then

        SafeState.Text =
            spawnCF
            and "State: READY • NEAREST SPAWN"
            or (
                "State: READY • "
                .. safeSource()
            )

