            false,
            "NOT AUTHORIZED"
        )

        return
    end

    local now =
        os.clock()

    if now
        - (
            LastRemoteRequest[
                controller
            ]
            or 0
        )
        < 0.02 then

        return
    end

    LastRemoteRequest[
        controller
    ] =
        now

    if action ==
        "SafeTeleport" then

        local destination =
            enabled

        if typeof(destination) ~=
            "CFrame" then

            sendResult(
                controller,
                action,
                false,
                "INVALID SAFE POSITION"
            )

            return
        end

        local position =
            destination.Position

        local finite =
            position.X == position.X
            and position.Y == position.Y
            and position.Z == position.Z
            and math.abs(position.X) < 10000000
            and math.abs(position.Y) < 10000000
            and math.abs(position.Z) < 10000000

        if not finite then

            sendResult(
                controller,
                action,
                false,
                "INVALID SAFE POSITION"
            )

            return
        end

        local c =
            character(
