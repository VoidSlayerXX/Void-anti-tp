local function flingTarget(
    controller,
    target
)

    if not target
        or target == controller
        or target.Parent ~= Players then

        return false,
            "INVALID TARGET"
    end

    if not alive(
        controller
    )
        or not alive(
            target
        ) then

        return false,
            "CHARACTER NOT READY"
    end

    if isTrusted(
        controller,
        target
    ) then

        return false,
            "TARGET IS TRUSTED"
    end

    if target:GetAttribute(
        "VoidHubFlingProtected"
    ) == true
        or target:GetAttribute(
            "VoidHubAntiFling"
        ) == true then

        return false,
            "TARGET FLING PROTECTED"
    end

    if not pvpAllowed(
        controller
    ) then

        return false,
            "ENTER PVP ZONE"
    end

    if not pvpAllowed(
        target
    ) then

        return false,
            "TARGET NOT IN PVP"
    end

    local now =
        os.clock()

    if now
        - (
            LastFling[
                controller
            ]
            or 0
        )
        < FLING_COOLDOWN then

        return false,
            "FLING COOLDOWN"
    end

    LastFling[
        controller
    ] =
        now

    local controllerRoot =
        root(
            controller
        )

    local targetRoot =
        root(
            target
        )

    if not controllerRoot
        or not targetRoot then

        return false,
            "CHARACTER NOT READY"
    end

    local direction =
        targetRoot.Position
        - controllerRoot.Position

    if direction.Magnitude <
        0.1 then

        direction =
            controllerRoot.CFrame.LookVector
    else

        direction =
            direction.Unit
    end

    setServerOwnership(
        target,
        true
    )

    targetRoot.AssemblyLinearVelocity =
        Vector3.zero

    targetRoot.AssemblyAngularVelocity =
        Vector3.zero

    local mass =
        math.max(
            targetRoot.AssemblyMass,
            1
        )

    targetRoot:ApplyImpulse(
        (
            direction
            * FLING_FORWARD_POWER
            +
            Vector3.new(
                0,
                FLING_UP_POWER,
                0
            )
        )
        * mass
    )

    targetRoot:ApplyAngularImpulse(
        Vector3.new(
            0,
            FLING_SPIN_POWER,
            FLING_SPIN_POWER * 0.55
        )
        * mass
    )

    task.delay(
        0.65,
        function()

            if target
                and target.Parent ==
                    Players then

                setServerOwnership(
                    target,
                    false
                )
            end
        end
    )

    return true,
        "FLUNG • "
        .. target.Name
end

local function setKillAura(
