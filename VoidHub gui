                local character =
                    player
                    and player.Character

                return character
                    and character:FindFirstChild(
                        "HumanoidRootPart"
                    )
            end

            local function localCharacterState()

                local character =
                    LocalPlayer.Character

                local root =
                    character
                    and character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                local humanoid =
                    character
                    and character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                return character,
                    root,
                    humanoid
            end

            local function pruneHistory(
                list,
                now
            )

                local write =
                    1

                for read = 1,
                    #list do

                    if now
                        - list[
                            read
                        ]
                        <= 6.0 then

                        list[
                            write
                        ] =
                            list[
                                read
                            ]

                        write +=
                            1
                    end
                end

                for index =
                    #list,
                    write,
                    -1 do

                    list[
                        index
                    ] =
                        nil
                end
            end

            local function closestCorrelation(
                beforePosition,
                afterPosition
            )

                local bestPlayer =
                    nil

                local bestBefore =
                    math.huge

                local bestAfter =
                    math.huge

                local bestCollapse =
                    -math.huge

                for _,
                    other in ipairs(
                        Players:GetPlayers()
                    ) do

                    if other ~=
                        LocalPlayer then

                        local otherRoot =
                            playerRoot(
                                other
                            )

                        if otherRoot then

                            local beforeDistance =
                                (
                                    beforePosition
                                    - otherRoot.Position
                                ).Magnitude

                            local afterDistance =
                                (
                                    afterPosition
                                    - otherRoot.Position
                                ).Magnitude

                            local collapse =
                                beforeDistance
                                - afterDistance

                            if afterDistance <=
                                18
                                and collapse >
                                    bestCollapse then

                                bestPlayer =
                                    other

                                bestBefore =
                                    beforeDistance

                                bestAfter =
                                    afterDistance

                                bestCollapse =
                                    collapse
                            end
                        end
                    end
                end

                return bestPlayer,
                    bestBefore,
                    bestAfter,
                    bestCollapse
            end

            local function confidenceFor(
                incident
            )

                if incident.Died then
                    return "HIGH • displacement + death correlation"
                end

                if (
                    incident.HealthLoss
                    or 0
                ) >=
                    35 then

                    return "HIGH • displacement + health-loss correlation"
                end

                if (
                    incident.RepeatCount
                    or 0
                ) >=
                    2 then

                    return "HIGH • repeated snap toward same player"
                end

                if incident.Candidate then
                    return "MEDIUM • movement correlation"
                end

                return "LOW • displacement only"
            end

            local function render()

                local lines = {
                    "VOID HUB BRING-LOCK WATCH",
                    "==============================",
                    enabled
                        and "Watcher: ON"
                        or "Watcher: OFF",
                    "Trigger: >=30 stud movement within <=0.35s",
                    "Correlation: ends within 18 studs of another player",
                    "",
                    "IMPORTANT:",
                    "Nearest/correlated player is evidence context only.",
                    "It does NOT prove that player caused the movement.",
                    "",
                    "INCIDENTS:"
                }

                if #incidents ==
                    0 then

                    table.insert(
                        lines,
                        "  none recorded"
                    )

                else

                    for index,
                        incident in ipairs(
                            incidents
                        ) do

                        table.insert(
                            lines,
                            ""
                        )

                        table.insert(
                            lines,
                            string.format(
                                "#%d  %.2fs",
                                incident.Id,
                                incident.Time
                            )
                        )

                        table.insert(
                            lines,
                            string.format(
                                "  Move: %.1f studs in %.2fs",
                                incident.MoveDistance,
                                incident.DeltaTime
                            )
                        )

                        table.insert(
                            lines,
                            string.format(
                                "  Y delta: %.1f",
                                incident.YDelta
                            )
                        )

                        if incident.Candidate then

                            table.insert(
                                lines,
                                "  Correlated player: @"
                                .. incident.Candidate
                            )

                            table.insert(
                                lines,
                                string.format(
                                    "  Distance to them: %.1f -> %.1f studs",
                                    incident.BeforeDistance,
                                    incident.AfterDistance
                                )
                            )

                            table.insert(
                                lines,
                                string.format(
                                    "  Distance collapse: %.1f studs",
                                    incident.Collapse
                                )
                            )

                            table.insert(
                                lines,
                                "  Same-player repeats (6s): "
                                .. tostring(
                                    incident.RepeatCount
                                    or 1
                                )
                            )

                        else

                            table.insert(
                                lines,
                                "  Correlated player: NONE"
                            )
                        end

                        table.insert(
                            lines,
                            string.format(
                                "  Health: %.0f -> %.0f",
                                incident.HealthBefore,
                                incident.HealthAfter
                                    or incident.HealthBefore
                            )
                        )

                        if (
                            incident.HealthLoss
                            or 0
                        ) >
                            0 then

                            table.insert(
                                lines,
                                string.format(
                                    "  Health loss after snap: %.0f",
                                    incident.HealthLoss
                                )
                            )
                        end

                        if incident.Died then

                            table.insert(
                                lines,
                                "  Death within correlation window: YES"
                            )
                        end

                        table.insert(
                            lines,
                            "  Confidence: "
                            .. confidenceFor(
                                incident
                            )
                        )
                    end
                end

                report.Text =
                    table.concat(
                        lines,
                        "\n"
                    )
            end

            local function notifyHigh(
                incident
            )

                local now =
                    os.clock()

                if now
                    - lastAlertAt <
                        2.0 then

                    return
                end

                if (
                    incident.RepeatCount
                    or 0
                ) <
                    2
                    and (
                        incident.HealthLoss
                        or 0
                    ) <
                        35
                    and not incident.Died then

                    return
                end

                lastAlertAt =
                    now

                pcall(function()

                    StarterGui:SetCore(
                        "SendNotification",
                        {
                            Title =
                                "VOID HUB • BRING WATCH",

                            Text =
                                incident.Candidate
                                and (
                                    "Repeated bring-like movement correlated near @"
                                    .. incident.Candidate
                                    .. ". Source not proven."
                                )
                                or "Repeated bring-like movement detected.",

                            Duration =
                                5
                        }
                    )
                end)
            end

            local function addIncident(
                beforePosition,
                afterPosition,
                dt,
                moveDistance,
                humanoid
            )

                incidentId +=
                    1

                local candidate,
                    beforeDistance,
                    afterDistance,
                    collapse =
                    closestCorrelation(
                        beforePosition,
                        afterPosition
                    )

                local repeatCount =
                    0

                if candidate then

                    local history =
                        candidateHistory[
                            candidate.UserId
                        ]

                    if not history then

                        history =
                            {}

                        candidateHistory[
                            candidate.UserId
                        ] =
                            history
                    end

                    local now =
                        os.clock()

                    pruneHistory(
                        history,
                        now
                    )

                    table.insert(
                        history,
                        now
                    )

                    repeatCount =
                        #history
                end

                local incident = {
                    Id =
                        incidentId,

                    Time =
                        os.clock(),

                    MoveDistance =
                        moveDistance,

                    DeltaTime =
                        dt,

                    YDelta =
                        afterPosition.Y
                        - beforePosition.Y,

                    Candidate =
                        candidate
                        and candidate.Name
                        or nil,

                    CandidateUserId =
                        candidate
                        and candidate.UserId
                        or nil,

                    BeforeDistance =
                        beforeDistance ~=
                            math.huge
                        and beforeDistance
                        or 0,

                    AfterDistance =
                        afterDistance ~=
                            math.huge
                        and afterDistance
                        or 0,

                    Collapse =
                        collapse ~=
                            -math.huge
                        and collapse
                        or 0,

                    RepeatCount =
                        repeatCount,

                    HealthBefore =
                        humanoid.Health,

                    HealthAfter =
                        humanoid.Health,

                    HealthLoss =
                        0,

                    Died =
                        false
                }

                table.insert(
                    incidents,
                    1,
                    incident
                )

                while #incidents >
                    20 do

                    table.remove(
                        incidents
                    )
                end

                pendingIncident = {
                    Incident =
                        incident,

                    Until =
                        os.clock()
                        + 1.10,

                    HealthBefore =
                        humanoid.Health
                }

                status.Text =
                    candidate
                    and (
                        "Status: BRING-LIKE SNAP • near @"
                        .. candidate.Name
                        .. " • source unknown"
                    )
                    or "Status: SUDDEN DISPLACEMENT"

                render()

                notifyHigh(
                    incident
                )
            end

            local function sample()

                local _,
                    root,
                    humanoid =
                    localCharacterState()

                if not root
                    or not humanoid then

                    lastPosition =
                        nil

                    lastTime =
                        nil

                    lastHealth =
                        nil

                    return
                end

                local now =
                    os.clock()

                local currentPosition =
                    root.Position

                local currentHealth =
                    humanoid.Health

                if pendingIncident then

                    if now <=
                        pendingIncident.Until then

                        local incident =
                            pendingIncident.Incident

                        if currentHealth <
                            (
                                incident.HealthAfter
                                or incident.HealthBefore
                            ) then

                            incident.HealthAfter =
                                currentHealth

                            incident.HealthLoss =
                                math.max(
                                    0,
                                    incident.HealthBefore
                                    - currentHealth
                                )

                            if currentHealth <=
                                0 then

                                incident.Died =
                                    true
                            end

                            render()

                            notifyHigh(
                                incident
                            )
                        end

                    else

                        pendingIncident =
                            nil
                    end
                end

                if lastPosition
                    and lastTime then

                    local dt =
                        now
                        - lastTime

                    if dt >
                        0
                        and dt <=
                            0.35 then

                        local displacement =
                            currentPosition
                            - lastPosition

                        local moveDistance =
                            displacement.Magnitude

                        if moveDistance >=
                            30
                            and humanoid.Health >
                                0 then

                            addIncident(
                                lastPosition,
                                currentPosition,
                                dt,
                                moveDistance,
                                humanoid
                            )
                        end
                    end
                end

                lastPosition =
                    currentPosition

                lastTime =
                    now

                lastHealth =
                    currentHealth
            end

            local function resetTracking()

                lastPosition =
                    nil

                lastTime =
                    nil

                lastHealth =
                    nil

                pendingIncident =
                    nil

                candidateHistory =
                    {}
            end

            toggleButton.Activated:Connect(function()

                enabled =
                    not enabled

                resetTracking()

                toggleButton.Text =
                    enabled
                    and "WATCH SELF: ON"
                    or "WATCH SELF: OFF"

                status.Text =
                    enabled
                    and "Status: WATCHING SELF • local only"
                    or "Status: OFF • no server link required"

                render()
            end)

            snapshotButton.Activated:Connect(function()

                local _,
                    root,
                    humanoid =
                    localCharacterState()

                if not root
                    or not humanoid then

                    status.Text =
                        "Status: CHARACTER NOT READY"

                    return
                end

                local nearest =
                    nil

                local nearestDistance =
                    math.huge

                for _,
                    other in ipairs(
                        Players:GetPlayers()
                    ) do

                    if other ~=
                        LocalPlayer then

                        local otherRoot =
                            playerRoot(
                                other
                            )

                        if otherRoot then

                            local distance =
                                (
                                    root.Position
                                    - otherRoot.Position
                                ).Magnitude

                            if distance <
                                nearestDistance then

                                nearest =
                                    other

                                nearestDistance =
                                    distance
                            end
                        end
                    end
                end

                status.Text =
                    nearest
                    and string.format(
                        "Snapshot: nearest @%s • %.1f studs • HP %.0f",
                        nearest.Name,
                        nearestDistance,
                        humanoid.Health
                    )
                    or string.format(
                        "Snapshot: no nearby player • HP %.0f",
                        humanoid.Health
                    )
            end)

            clearButton.Activated:Connect(function()

                incidents =
                    {}

                candidateHistory =
                    {}

                pendingIncident =
                    nil

                incidentId =
                    0

                status.Text =
                    enabled
                    and "Status: WATCHING SELF • incidents cleared"
                    or "Status: OFF • incidents cleared"

                render()
            end)

            RunService.Heartbeat:Connect(function(
                dt
            )

                if not enabled then
                    return
                end

                accumulator +=
                    dt

                if accumulator <
                    0.10 then

                    return
                end

                accumulator =
                    0

                pcall(
                    sample
                )
            end)

            LocalPlayer.CharacterAdded:Connect(function()

                resetTracking()

                task.delay(
                    0.8,
                    function()

                        if enabled then

                            status.Text =
                                "Status: WATCHING SELF • respawned"
                        end
                    end
                )
            end)

            render()
        end)

    if not ok then

        warn(
            "VOID HUB BRING WATCH ERROR: "
            .. tostring(
                err
            )
        )
    end
end



