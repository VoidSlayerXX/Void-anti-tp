            local function alert(
                incident
            )

                local level =
                    confidence(
                        incident
                    )

                if level ~=
                    "HIGH"
                    and level ~=
                        "CRITICAL" then

                    return
                end

                local now =
                    os.clock()

                if now
                    - lastAlert <
                        1.0 then

                    return
                end

                lastAlert =
                    now

                pcall(function()

                    StarterGui:SetCore(
                        "SendNotification",
                        {
                            Title =
                                "VOID HUB X • "
                                .. level,

                            Text =
                                incident.WatchTargetCorrelated
                                and (
                                    classify(
                                        incident
                                    )
                                    .. " correlated with @"
                                    .. watchedUsername
                                    .. ". Source not proven."
                                )
                                or incident.Candidate
                                    and (
                                        classify(
                                            incident
                                        )
                                        .. " near @"
                                        .. incident.Candidate
                                        .. ". Source not proven."
                                    )
                                    or (
                                        classify(
                                            incident
                                        )
                                        .. ". Source unknown."
                                    ),

                            Duration =
                                7
                        }
                    )
                end)
            end

            local function addIncident(
                previous,
                current,
                flags,
                signalScore
            )

                local now =
                    os.clock()

                if now
                    - lastIncidentAt <
                        0.18 then

                    return
                end

                lastIncidentAt =
                    now

                incidentId +=
                    1

                local moveDistance =
                    (
                        current.Position
                        - previous.Position
                    ).Magnitude

                local dt =
                    math.max(
                        current.Time
                        - previous.Time,
                        0.001
                    )

                local teleportSpeed =
                    moveDistance
                    / dt

                local correlation =
                    bestCorrelation(
                        previous.Position,
                        current.Position
                    )

                local watchCorrelation =
                    watchedDistances(
                        previous.Position,
                        current.Position
                    )

                local watchTargetCorrelated =
                    watchCorrelation
                    and (
                        watchCorrelation.AfterDistance <=
                            12
                        or watchCorrelation.Collapse >=
                            30
                    )
                    or false

                local watchTargetRepeatCount =
                    0

                if watchTargetCorrelated
                    and watchCorrelation
                    and watchCorrelation.Player then

                    local nowWatch =
                        os.clock()

                    pruneTimes(
                        targetRepeatTimes,
                        nowWatch
                    )

                    table.insert(
                        targetRepeatTimes,
                        nowWatch
                    )

                    watchTargetRepeatCount =
                        #targetRepeatTimes

                    signalScore +=
                        watchCorrelation.AfterDistance <=
                                5
                            and 3
                            or watchCorrelation.Collapse >=
                                    100
                                and 3
                                or 2

                    table.insert(
                        flags,
                        "WATCH_TARGET_CORRELATION"
                    )

                    if watchCorrelation.AfterDistance <=
                        5 then

                        table.insert(
                            flags,
                            "WATCH_TARGET_WITHIN_5"
                        )
                    end

                    if watchCorrelation.Collapse >=
                        100 then

                        table.insert(
                            flags,
                            "WATCH_TARGET_COLLAPSE_100+"
                        )
                    end
                end

                local candidate =
                    correlation
                    and correlation.Player
                    or nil

                local repeatCount =
                    candidate
                    and repeatCountFor(
                        candidate.UserId,
                        now
                    )
                    or 0

                if correlation then

                    signalScore +=
                        correlation.Score

                    if correlation.AfterDistance <=
                        5 then

                        table.insert(
                            flags,
                            "LANDING_WITHIN_5_STUDS"
                        )

                    elseif correlation.AfterDistance <=
                        12 then

                        table.insert(
                            flags,
                            "LANDING_WITHIN_12_STUDS"
                        )
                    end

                    if correlation.Collapse >=
                        100 then

                        table.insert(
                            flags,
                            "DISTANCE_COLLAPSE_100+"
                        )

                    elseif correlation.Collapse >=
                        50 then

                        table.insert(
                            flags,
                            "DISTANCE_COLLAPSE_50+"
                        )
                    end
                end

                local incident = {
                    Id =
                        incidentId,

                    Time =
                        now,

                    MoveDistance =
                        moveDistance,

                    DeltaTime =
                        dt,

                    TeleportSpeed =
                        teleportSpeed,

                    YDelta =
                        current.Position.Y
                        - previous.Position.Y,

                    LinearVelocity =
                        current.LinearVelocity,

                    AngularVelocity =
                        current.AngularVelocity,

                    HealthBefore =
                        previous.Health,

                    HealthAfter =
                        current.Health,

                    HealthLoss =
                        math.max(
                            0,
                            previous.Health
                            - current.Health
                        ),

                    Died =
                        current.Health <=
                        0,

                    Flags =
                        flags,

                    SignalScore =
                        signalScore,

                    Nearby =
                        nearbyContext(
                            current.Position
                        ),

                    Candidate =
                        candidate
                        and candidate.Name
                        or nil,

                    CandidateUserId =
                        candidate
                        and candidate.UserId
                        or nil,

                    CandidateBeforeDistance =
                        correlation
                        and correlation.BeforeDistance
                        or nil,

                    CandidateDistance =
                        correlation
                        and correlation.AfterDistance
                        or nil,

                    DistanceCollapse =
                        correlation
                        and correlation.Collapse
                        or nil,

                    RepeatCount =
                        repeatCount,

                    WatchTargetOnline =
                        watchCorrelation ~= nil,

                    WatchTargetBeforeDistance =
                        watchCorrelation
                        and watchCorrelation.BeforeDistance
                        or nil,

                    WatchTargetAfterDistance =
                        watchCorrelation
                        and watchCorrelation.AfterDistance
                        or nil,

                    WatchTargetCollapse =
                        watchCorrelation
                        and watchCorrelation.Collapse
                        or nil,

                    WatchTargetCorrelated =
                        watchTargetCorrelated,

                    WatchTargetRepeatCount =
                        watchTargetRepeatCount
                }

                local uiTrigger =
                    _G.VoidHubUITrigger

                if type(
                    uiTrigger
                ) == "table"
                    and type(
                        uiTrigger.Time
                    ) == "number"
                    and now
                        - uiTrigger.Time >=
                            0
                    and now
                        - uiTrigger.Time <=
                            3.0 then

                    incident.UITriggerMatched =
                        true

                    incident.UITriggerText =
                        tostring(
                            uiTrigger.Text
                            or ""
                        )

                    incident.UITriggerDelay =
                        now
                        - uiTrigger.Time

                    incident.UITriggerCount =
                        uiTrigger.Count
                        or 0

                    incident.SignalScore +=
                        2

                    table.insert(
                        incident.Flags,
                        "UI_TRIGGER_TURTLE0752_ACCEPTED"
                    )

                    uiTrigger.MatchedIncidentId =
                        incident.Id

                    uiTrigger.MatchedLevel =
                        nil

                    uiTrigger.MatchedDelay =
                        incident.UITriggerDelay
                end

                if watchTargetCorrelated then

                    targetIncidentCount +=
                        1
                end

                local level,
                    scored =
                    confidence(
                        incident
                    )

                if incident.UITriggerMatched
                    and type(
                        _G.VoidHubUITrigger
                    ) == "table" then

                    _G.VoidHubUITrigger.MatchedLevel =
                        level
                end

                _G.VoidHubLastMaxIncident = {
                    Id =
                        incident.Id,

                    Time =
                        incident.Time,

                    Level =
                        level,

                    Class =
                        classify(
                            incident
                        ),

                    UITriggerMatched =
                        incident.UITriggerMatched == true,

                    UITriggerDelay =
                        incident.UITriggerDelay,

                    MoveDistance =
                        incident.MoveDistance,

                    DeltaTime =
                        incident.DeltaTime,

                    TeleportSpeed =
                        incident.TeleportSpeed,

                    YDelta =
                        incident.YDelta,

                    LinearVelocity =
                        incident.LinearVelocity,

                    AngularVelocity =
                        incident.AngularVelocity,

                    HealthBefore =
                        incident.HealthBefore,

                    HealthAfter =
                        incident.HealthAfter,

                    HealthLoss =
                        incident.HealthLoss,

                    Died =
                        incident.Died == true,

                    Candidate =
                        incident.Candidate,

                    WatchTargetCorrelated =
                        incident.WatchTargetCorrelated == true,

                    Flags =
                        incident.Flags,

                    Nearby =
                        incident.Nearby
                }

                sessionScore +=
                    scored

                if level ==
                    "CRITICAL" then

                    highestLevel =
                        "CRITICAL"

                    lastCriticalIncident =
                        incident

                    if incident.WatchTargetCorrelated then

                        targetCriticalCount +=
                            1
                    end

                elseif level ==
                    "HIGH"
                    and highestLevel ~=
                        "CRITICAL" then

                    highestLevel =
                        "HIGH"

                elseif level ==
                    "MEDIUM"
                    and highestLevel ==
                        "NORMAL" then

                    highestLevel =
                        "MEDIUM"

                elseif level ==
                    "LOW"
                    and highestLevel ==
                        "NORMAL" then

                    highestLevel =
                        "LOW"
                end

                table.insert(
                    incidents,
                    1,
                    incident
                )

                while #incidents >
                    60 do

                    table.remove(
                        incidents
                    )
                end

                pending = {
                    Incident =
                        incident,

                    Until =
                        now
                        + 1.50
                }

                status.Text =
                    "Status: "
                    .. level
                    .. " • "
                    .. classify(
                        incident
                    )
                    .. " • source unknown"

                render()

                alert(
                    incident
                )
            end

            local function pushSample()

                local root,
                    humanoid =
                    characterState()

                if not root
                    or not humanoid then

                    samples =
                        {}

                    pending =
                        nil

                    return
                end

                local now =
                    os.clock()

                local current = {
                    Time =
                        now,

                    Position =
                        root.Position,

                    Health =
                        humanoid.Health,

                    LinearVelocity =
                        root.AssemblyLinearVelocity.Magnitude,

                    AngularVelocity =
                        root.AssemblyAngularVelocity.Magnitude
                }

                if pending then

                    if now <=
                        pending.Until then

                        local incident =
                            pending.Incident

                        if current.Health <
                            (
                                incident.HealthAfter
                                or incident.HealthBefore
                            ) then

                            incident.HealthAfter =
                                current.Health

                            incident.HealthLoss =
                                math.max(
                                    0,
                                    incident.HealthBefore
                                    - current.Health
                                )

                            if current.Health <=
                                0 then

                                incident.Died =
                                    true

                                lastDeathAt =
                                    now

                                incident.DeathAfter =
                                    math.max(
                                        0,
                                        now
                                        - incident.Time
                                    )
                            end

                            render()

                            alert(
                                incident
                            )
                        end

                    else

                        pending =
                            nil
                    end
                end

                local previous =
                    samples[
                        #samples
                    ]

                if previous then

                    local dt =
                        math.max(
                            current.Time
                            - previous.Time,
                            0.001
                        )

                    local delta =
                        current.Position
                        - previous.Position

                    local distance =
                        delta.Magnitude

                    local absoluteY =
                        math.abs(
                            delta.Y
                        )

                    local teleportSpeed =
                        distance
                        / dt

                    local flags = {}

                    local signalScore =
                        0

                    local movePoints,
                        moveFlag =
                        movementScore(
                            distance
                        )

                    if movePoints >
                        0 then

                        signalScore +=
                            movePoints

                        table.insert(
                            flags,
                            moveFlag
                        )
                    end

                    local verticalPoints,
                        verticalFlag =
                        verticalScore(
                            absoluteY
                        )

                    if verticalPoints >
                        0 then

                        signalScore +=
                            verticalPoints

                        table.insert(
                            flags,
                            verticalFlag
                        )
                    end

                    if teleportSpeed >=
                        8000 then

                        signalScore +=
                            5

                        table.insert(
                            flags,
                            "TELEPORT_SPEED_8000+"
                        )

                    elseif teleportSpeed >=
                        2500 then

                        signalScore +=
                            3

                        table.insert(
                            flags,
                            "TELEPORT_SPEED_2500+"
                        )

                    elseif teleportSpeed >=
                        800 then

                        signalScore +=
                            1

                        table.insert(
                            flags,
                            "TELEPORT_SPEED_800+"
                        )
                    end

                    if distance >=
                        100
                        and current.LinearVelocity <
                            25 then

                        signalScore +=
                            4

                        table.insert(
                            flags,
                            "VELOCITY_MISMATCH_POSITION_SET"
                        )
                    end

                    if current.LinearVelocity >=
                        140 then

                        signalScore +=
                            1

                        table.insert(
                            flags,
                            "EXTREME_LINEAR"
                        )
                    end

                    if current.AngularVelocity >=
                        60 then

                        signalScore +=
                            1

                        table.insert(
                            flags,
                            "EXTREME_ANGULAR"
                        )
                    end

                    local healthDrop =
                        previous.Health
                        - current.Health

                    if healthDrop >=
                        50 then

                        signalScore +=
                            4

                        table.insert(
                            flags,
                            "HEALTH_DROP_50+"
                        )

                    elseif healthDrop >=
                        20 then

                        signalScore +=
                            2

                        table.insert(
                            flags,
                            "HEALTH_DROP_20+"
                        )
                    end

                    if signalScore >=
                        3 then

                        addIncident(
                            previous,
                            current,
                            flags,
                            signalScore
                        )
                    end
                end

                table.insert(
                    samples,
                    current
                )

                while #samples >
                    80 do

                    table.remove(
                        samples,
                        1
                    )
                end
            end

            local function manualRecord()

                local root,
                    humanoid =
                    characterState()

                if not root
                    or not humanoid then

                    status.Text =
                        "Status: CHARACTER NOT READY"

                    return
                end

                incidentId +=
                    1

                local context =
                    nearbyContext(
                        root.Position
                    )

                local candidate =
                    context[
                        1
                    ]

                local incident = {
                    Id =
                        incidentId,

                    Time =
                        os.clock(),

