                    currentHumanoid.AutoRotate =
                        true

                    currentHumanoid.PlatformStand =
                        false

                    currentHumanoid.Sit =
                        false

                    currentHumanoid.WalkSpeed =
                        16
                end

                setServerOwnership(
                    targetPlayer,
                    false
                )
            end
        end
    )

    return true
end


