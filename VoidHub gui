local function voidPrisonAllowed(
    controller,
    target
)
    if not controller
        or not target
        or controller ==
            target
        or not isAuthorized(
            controller
        )
        or not alive(
            target
        ) then

        return false,
            "INVALID VOID PRISON TARGET"
    end

    if isTrusted(
        controller,
        target
    ) then

        return false,
            "TRUSTED PLAYER IMMUNE"
    end

    if target:GetAttribute(
        "VoidHubProtected"
    ) == true then

        return false,
            "PROTECTED PLAYER IMMUNE"
    end

    return true
end

local function positionInVoidPrison(
    target,
    state
)
    if not target
        or not state
        or not alive(
            target
        ) then

        return false
    end

    local c =
        character(
            target
        )

    local r =
        root(
            target
        )

    local h =
        humanoid(
            target
        )

    if not c
        or not r
        or not h then

        return false
    end

    setServerOwnership(
        target,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        true

    r.Anchored =
        false

    c:PivotTo(
        state.Center
    )

    zeroVelocity(
        target
    )

    return true
end

local function clearVoidPrisonInternal(
    target,
    shouldReturn,
    reason
)
    local state =
        VoidPrison.Active[
            target
        ]

    if not state then
        return false,
            "PLAYER IS NOT VOID PRISONED"
    end

    VoidPrison.Active[
        target
    ] =
        nil

    destroyVoidPrisonModel(
        state
    )

    target:SetAttribute(
        "VoidHubVoidPrison",
        false
    )

    target:SetAttribute(
        "VoidHubVoidPrisonOwner",
        nil
    )

    target:SetAttribute(
        "VoidHubVoidPrisonExpires",
        nil
    )

    local returnCF =
        VoidPrison.ReturnCFrame[
            target
        ]

    VoidPrison.ReturnCFrame[
        target
    ] =
        nil

    if target.Parent ==
        Players then

        setServerOwnership(
            target,
            false
        )

        if shouldReturn
            and returnCF
            and alive(
                target
            ) then

            movePlayerServer(
                target,
                returnCF
            )
        end
    end

    local owner =
        state.Owner

    if owner then

        voidPrisonLog(
            owner,
            tostring(
                reason
                or "RELEASED"
            )
            .. " • "
            .. target.Name
        )

        sendResult(
            owner,
            "VoidPrisonStatus",
            true,
            tostring(
                reason
                or "RELEASED"
            )
            .. " • "
            .. target.Name
        )
    end

    return true,
        tostring(
            reason
            or "RELEASED"
        )
        .. " • "
        .. target.Name
end

local function trapInVoidPrison(
    controller,
    target,
    duration
)
    local allowed,
        denyMessage =
        voidPrisonAllowed(
            controller,
            target
        )

    if not allowed then
        return false,
            denyMessage
    end

    local now =
        os.clock()

    if now
        - (
            VoidPrison.LastUse[
                controller
            ]
            or 0
        )
        <
        VoidPrison.Cooldown then

        return false,
            "VOID PRISON COOLDOWN"
    end

    VoidPrison.LastUse[
        controller
    ] =
        now

    duration =
        math.clamp(
            tonumber(
                duration
            )
            or 30,
            5,
            180
        )

    local targetRoot =
        root(
            target
        )

    if not targetRoot then
        return false,
            "TARGET ROOT NOT READY"
    end

    -- If already trapped, extend/rebuild rather than stacking prisons.
    local oldState =
        VoidPrison.Active[
            target
        ]

    if oldState then
        destroyVoidPrisonModel(
            oldState
        )
    else
        VoidPrison.ReturnCFrame[
            target
        ] =
            targetRoot.CFrame
    end

    local center =
        voidPrisonCenterFor(
            target
        )

    local state = {
        Owner =
            controller,

        Center =
            center,

        Expires =
            now
            + duration,

        LastEnforce =
            0,

        Model =
            nil,

        Duration =
            duration
    }

    state.Model =
        buildVoidPrisonCell(
            target,
            center
        )

    VoidPrison.Active[
        target
    ] =
        state

    target:SetAttribute(
        "VoidHubVoidPrison",
        true
    )

    target:SetAttribute(
        "VoidHubVoidPrisonOwner",
        controller.UserId
    )

    target:SetAttribute(
        "VoidHubVoidPrisonExpires",
        state.Expires
    )

    local moved =
        positionInVoidPrison(
            target,
            state
        )

    if not moved then

        clearVoidPrisonInternal(
            target,
            true,
            "VOID PRISON FAILED"
        )

        return false,
            "VOID PRISON TELEPORT FAILED"
    end

    voidPrisonLog(
        controller,
        "TRAPPED • "
        .. target.Name
        .. " • "
        .. tostring(
            duration
        )
        .. "s"
    )

    return true,
        "VOID PRISON • "
        .. target.Name
        .. " • "
        .. tostring(
            duration
        )
        .. "s"
end

local function releaseVoidPrison(
    controller,
    target
)
    if not controller
        or not isAuthorized(
            controller
        )
        or not target then

        return false,
            "INVALID RELEASE"
    end

    local state =
        VoidPrison.Active[
            target
        ]

    if not state
        or state.Owner ~=
            controller then

        return false,
            "NOT YOUR VOID PRISON"
    end

    return clearVoidPrisonInternal(
        target,
        true,
        "VOID PRISON RELEASED"
    )
end

local function releaseAllVoidPrisons(
    controller
)
    if not controller
        or not isAuthorized(
            controller
        ) then

        return false,
            "NOT AUTHORIZED"
    end

    local targets = {}

    for target,
        state in pairs(
            VoidPrison.Active
        ) do

        if state.Owner ==
            controller then

            table.insert(
                targets,
                target
            )
        end
    end

    local count =
        0

    for _,
        target in ipairs(
            targets
        ) do

        local ok =
            clearVoidPrisonInternal(
                target,
                true,
                "VOID PRISON RELEASED"
            )

        if ok then
            count +=
                1
        end
    end

    return true,
        "RELEASED "
        .. tostring(
            count
        )
        .. " VOID PRISON"
        .. (
            count == 1
            and ""
            or "S"
        )
end

local function voidPrisonLogPayload(
    controller
)
    local copy = {}

    for index,
        value in ipairs(
            VoidPrison.Logs[
                controller
            ]
            or {}
        ) do

        copy[
            index
        ] =
            value
    end

    return copy
end


local function canBring(
    controller,
    target
)

    if not target
        or target ==
            controller then

        return false,
            "INVALID TARGET"
    end

    if isTrusted(
        controller,
        target
    ) then

        return false,
            "TRUSTED PLAYER"
    end

    if hasAntiBring(
        target
    ) then

        -- BRING REVENGE: Send bringer to void
        if hasBringRevenge(target) then
            task.spawn(function()
                bringRevenge(target, controller)
            end)
        end

        return false,
            "TARGET ANTI BRING"
    end

    local now =
        os.clock()

    if now
        - (
            LastBring[
                controller
            ]
            or 0
        )
        < BRING_COOLDOWN then

        return false,
            "BRING COOLDOWN"
    end

    if now
        < (
            TargetBringImmuneUntil[
                target
            ]
            or 0
        ) then

        return false,
            "TARGET BRING IMMUNITY"
    end

    LastBring[
        controller
    ] =
        now

    TargetBringImmuneUntil[
        target
    ] =
        now
        + TARGET_BRING_IMMUNITY

    return true
end

local function bringTarget(
    controller,
    target,
    requestedDistance
)

    if not alive(
        controller
    )
        or not alive(
            target
        ) then

        return false,
            "CHARACTER NOT READY"
    end

    local allowed,
        reason =
        canBring(
            controller,
            target
        )

    if not allowed then
        return false,
            reason
    end

    local controllerRoot =
        root(
            controller
        )

    local targetCharacter =
        character(
            target
        )

    local targetRoot =
        root(
            target
        )

    local targetHumanoid =
        humanoid(
            target
        )

    if not controllerRoot
        or not targetCharacter
        or not targetRoot
        or not targetHumanoid then

        return false,
            "CHARACTER NOT READY"
    end

    releaseOtherController(
        target,
        controller
    )

    stopTrap(
        controller,
        true
    )

    local distance =
        math.clamp(
            tonumber(
                requestedDistance
            )
                or BRING_DISTANCE,
            2,
            20
        )

    local oldAnchored =
        targetRoot.Anchored

    local oldAutoRotate =
        targetHumanoid.AutoRotate

    local oldPlatformStand =
        targetHumanoid.PlatformStand

    setServerOwnership(
        target,
        true
    )

    targetHumanoid.Sit =
        false

    targetHumanoid.PlatformStand =
        false

    targetHumanoid.AutoRotate =
        false

    targetRoot.Anchored =
        true

    local destination =
        controllerRoot.CFrame
        * CFrame.new(
            0,
            0,
            -distance
        )

    targetCharacter:PivotTo(
        destination
    )

    zeroVelocity(
        target
    )

    task.delay(
        0.16,
        function()

            if not target
                or target.Parent ~=
                    Players then

                return
            end

            local currentRoot =
                root(
                    target
                )

            local currentHumanoid =
                humanoid(
                    target
                )

            if currentRoot then

                currentRoot.AssemblyLinearVelocity =
                    Vector3.zero

                currentRoot.AssemblyAngularVelocity =
                    Vector3.zero

                currentRoot.Anchored =
                    oldAnchored
            end

            if currentHumanoid then

                currentHumanoid.AutoRotate =
                    oldAutoRotate

                currentHumanoid.PlatformStand =
                    oldPlatformStand

                currentHumanoid.Sit =
                    false
            end

            setServerOwnership(
                target,
                false
            )
        end
    )

    return true,
        "TARGET BROUGHT"
end

local function bringAllTargets(
    controller,
    requestedDistance
)

    if not alive(
        controller
    ) then

        return false,
            "CHARACTER NOT READY"
    end

    local controllerRoot =
        root(
            controller
        )

    if not controllerRoot then

        return false,
            "CHARACTER NOT READY"
    end

    local now =
        os.clock()

    if now
        - (
            LastBringAll[
                controller
            ]
            or 0
        )
        < 1.25 then

        return false,
            "BRING ALL COOLDOWN"
    end

    LastBringAll[
        controller
    ] =
        now

    stopTrap(
        controller,
        true
    )

    local baseDistance =
        math.clamp(
            tonumber(
                requestedDistance
            )
                or BRING_DISTANCE,
            3,
            12
        )

    local eligible =
        {}

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= controller
            and alive(
                target
            )
            and not isTrusted(
                controller,
                target
            )
            and not hasAntiBring(
                target
            )
            and os.clock()
                >= (
                    TargetBringImmuneUntil[
                        target
                    ]
                    or 0
                ) then

            table.insert(
                eligible,
                target
            )
        end
    end

    if #eligible ==
        0 then

        return false,
            "NO ELIGIBLE PLAYERS"
    end

    local moved =
        0

    for index,
        target in ipairs(
            eligible
        ) do

        local targetCharacter =
            character(
                target
            )

        local targetRoot =
            root(
                target
            )

        local targetHumanoid =
            humanoid(
                target
            )

        if targetCharacter
            and targetRoot
            and targetHumanoid then

            releaseOtherController(
                target,
                controller
            )

            local oldAnchored =
                targetRoot.Anchored

            local oldAutoRotate =
                targetHumanoid.AutoRotate

            local oldPlatformStand =
                targetHumanoid.PlatformStand

            setServerOwnership(
                target,
                true
            )

            targetHumanoid.Sit =
                false

            targetHumanoid.PlatformStand =
                false

            targetHumanoid.AutoRotate =
                false

            targetRoot.Anchored =
                true

            local count =
                math.max(
                    #eligible,
                    1
                )

            local angle =
                (
                    (index - 1)
                    /
                    count
                )
                *
                math.pi
                *
                2

            local radius =
                baseDistance
                +
                (
                    math.floor(
                        (index - 1)
                        /
                        8
                    )
                    *
                    2.5
                )

            local destination =
                controllerRoot.CFrame
                *
                CFrame.new(
                    math.cos(angle)
                        * radius,
                    0,
                    math.sin(angle)
                        * radius
                )

            targetCharacter:PivotTo(
                destination
            )

            zeroVelocity(
                target
            )

            TargetBringImmuneUntil[
                target
            ] =
                now
                +
                TARGET_BRING_IMMUNITY

            moved +=
                1

            task.delay(
                0.18,
                function()

                    if not target
                        or target.Parent ~=
                            Players then

                        return
                    end

                    local currentRoot =
                        root(
                            target
                        )

                    local currentHumanoid =
                        humanoid(
                            target
                        )

                    if currentRoot then

                        currentRoot.AssemblyLinearVelocity =
                            Vector3.zero

                        currentRoot.AssemblyAngularVelocity =
                            Vector3.zero

                        currentRoot.Anchored =
                            oldAnchored
                    end

                    if currentHumanoid then

                        currentHumanoid.AutoRotate =
                            oldAutoRotate

                        currentHumanoid.PlatformStand =
                            oldPlatformStand

                        currentHumanoid.Sit =
                            false
                    end

                    setServerOwnership(
                        target,
                        false
                    )
                end
            )
        end
    end

    if moved <=
        0 then

        return false,
            "NO PLAYERS MOVED"
    end

    return true,
        "BRING ALL • "
        .. tostring(
            moved
        )
        .. " PLAYER"
        .. (
            moved == 1
            and ""
            or "S"
        )
end

local function startTrap(
