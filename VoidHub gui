clearGrabState = function(player)

    if not hasAntiGrab(
        player
    ) then

        return false
    end

    if not pvpAllowed(
        player
    ) then

        return false
    end

    local c =
        character(
            player
        )

    local h =
        humanoid(
            player
        )

    local r =
        root(
            player
        )

    if not c
        or not h
        or not r then

        return false
    end

    local changed =
        false

    local victimEvidence =
        hasGrabVictimEvidence(
            player
        )

    if not victimEvidence then

        local outgoingLinked =
            findCrossCharacterLinkedPlayer(
                player
            )

        if not outgoingLinked
            and h.Health > 0
            and not h.PlatformStand
            and not r.Anchored
            and os.clock()
                - (
                    AntiGrabGuard.LastTrigger[
                        player
                    ]
                    or 0
                ) >
                0.8 then

            AntiGrabGuard.SafeCFrame[
                player
            ] =
                r.CFrame
        end

        return false
    end

    -- Clear common grabbed/carried attributes.
    for attributeName in pairs(
        GRAB_STATE_NAMES
    ) do

        if player:GetAttribute(
            attributeName
        ) == true then

            player:SetAttribute(
                attributeName,
                false
            )

            changed =
                true
        end

        if c:GetAttribute(
            attributeName
        ) == true then

            c:SetAttribute(
                attributeName,
                false
            )

            changed =
                true
        end
    end

    -- Clear common named state values under Player / Backpack.
    for _, object in ipairs(
        player:GetDescendants()
    ) do

        if nameLooksLikeGrab(
            object.Name
        ) then

            if object:IsA(
                "BoolValue"
            ) then

                if object.Value then

                    object.Value =
                        false

                    changed =
                        true
                end

            elseif object:IsA(
                "ObjectValue"
            ) then

                if object.Value ~= nil then

                    object.Value =
                        nil

                    changed =
                        true
                end

            elseif object:IsA(
                "StringValue"
            ) then

                if object.Value ~= "" then

                    object.Value =
                        ""

                    changed =
                        true
                end

            elseif object:IsA(
                "IntValue"
            )
                or object:IsA(
                    "NumberValue"
                ) then

                if object.Value ~= 0 then

                    object.Value =
                        0

                    changed =
                        true
                end
            end
        end
    end

    -- Remove grab movers and cross-character links parented to us.
    for _, object in ipairs(
        c:GetDescendants()
    ) do

        local looksGrabby =
            nameLooksLikeGrab(
                object.Name
            )

        if looksGrabby then

            if object:IsA(
                "BoolValue"
            ) then

                if object.Value then

                    object.Value =
                        false

                    changed =
                        true
                end

            elseif object:IsA(
                "ObjectValue"
            ) then

                if object.Value ~= nil then

                    object.Value =
                        nil

                    changed =
                        true
                end

            elseif object:IsA(
                "AlignPosition"
            )
                or object:IsA(
                    "AlignOrientation"
                )
                or object:IsA(
                    "LinearVelocity"
                )
                or object:IsA(
                    "AngularVelocity"
                )
                or object:IsA(
                    "VectorForce"
                )
                or object:IsA(
                    "BodyPosition"
                )
                or object:IsA(
                    "BodyGyro"
                )
                or object:IsA(
                    "BodyVelocity"
                ) then

                object:Destroy()

                changed =
                    true

            elseif externalJointTouchesCharacter(
                object,
                c
            ) then

                object:Destroy()

                changed =
                    true
            end

        elseif externalJointTouchesCharacter(
            object,
            c
        ) then

            object:Destroy()

            changed =
                true
        end
    end

    -- Grab links are often parented to the grabber instead of the victim.
    for _, otherPlayer in ipairs(
        Players:GetPlayers()
    ) do

        if otherPlayer ~= player
            and otherPlayer.Character then

            for _, object in ipairs(
                otherPlayer.Character:GetDescendants()
            ) do

                if externalJointTouchesCharacter(
                    object,
                    c
                ) then

                    object:Destroy()

                    changed =
                        true
                end
            end
        end
    end

    -- Fallback for grabs that simply force PlatformStand/anchor near another
    -- player and expose no obvious named value/constraint.
    if not changed
        and (
            h.PlatformStand
            or r.Anchored
        ) then

        for _, otherPlayer in ipairs(
            Players:GetPlayers()
        ) do

            if otherPlayer ~= player then

                local otherRoot =
                    root(
                        otherPlayer
                    )

                if otherRoot
                    and (
                        otherRoot.Position
                        - r.Position
                    ).Magnitude <=
                        15 then

                    changed =
                        true

                    break
                end
            end
        end
    end

    if changed then

        AntiGrabGuard.LastTrigger[
            player
        ] =
            os.clock()

        h.Sit =
            false

        h.PlatformStand =
            false

        h.AutoRotate =
            true

        r.Anchored =
            false

        r.AssemblyLinearVelocity =
            Vector3.zero

        r.AssemblyAngularVelocity =
            Vector3.zero

        r.Velocity =
            Vector3.zero

        setServerOwnership(
            player,
            true
        )

        local safeCF =
            AntiGrabGuard.SafeCFrame[
                player
            ]

        if safeCF then

            c:PivotTo(
                safeCF
            )

            r.AssemblyLinearVelocity =
                Vector3.zero

            r.AssemblyAngularVelocity =
                Vector3.zero

            r.Velocity =
                Vector3.zero
        end

        -- Hold server ownership a little longer so the grabber/client cannot
        -- instantly re-apply the same physics link.
        task.delay(
            1.0,
            function()

                if player
                    and player.Parent ==
                        Players then

                    setServerOwnership(
                        player,
                        false
                    )
                end
            end
        )

    else

        -- Remember the most recent normal position for snapback.
        if h.Health > 0
            and not h.PlatformStand
            and not r.Anchored
            and os.clock()
                - (
                    AntiGrabGuard.LastTrigger[
                        player
                    ]
                    or 0
                ) >
                0.8 then

            AntiGrabGuard.SafeCFrame[
                player
            ] =
                r.CFrame
        end
    end

    return changed
end


pvpAllowed = function(player)

    if not player then
        return false
    end

    local value =
        player:GetAttribute(
            "InPvPZone"
        )

    if type(value) ==
        "boolean" then

        return value
    end

    return true
end

isTrusted = function(
    controller,
    target
)

    if not controller
        or not target then

        return false
    end

    local settings =
        settingsFor(
            controller
        )

    return settings.Trusted[
        target.UserId
    ] == true
end

local function stopZigZagBehind(
    controller
)

    ZigZagStates[
        controller
    ] =
        nil
end

local function setZigZagBehind(
    controller,
    target,
    enabled
)

    if enabled ~= true then

        stopZigZagBehind(
            controller
        )

        return true,
            "ZIGZAG BEHIND OFF"
    end

    if not target
        or target == controller
        or not alive(
            controller
        )
        or not alive(
            target
        ) then

        return false,
            "INVALID TARGET"
    end

    if isTrusted(
        controller,
        target
    ) then

        return false,
            "TRUSTED PLAYER"
    end

    ZigZagStates[
        controller
    ] = {
        Target = target,
        Side = 1
    }

    return true,
        "ZIGZAG BEHIND ON • "
        .. target.Name
end

local function findRearThreat(
    controller
)

    local myRoot =
        root(
            controller
        )

    if not myRoot then

        return nil
    end

    local closest
    local bestDistance =
        9

    for _, other in ipairs(
        Players:GetPlayers()
    ) do

        if other ~= controller
            and alive(
                other
            )
            and not isTrusted(
                controller,
                other
            ) then

            local otherRoot =
                root(
                    other
                )

            if otherRoot then

                local offset =
                    otherRoot.Position
                    - myRoot.Position

                local distance =
                    offset.Magnitude

                if distance > 0.1
                    and distance <
                        bestDistance then

                    local direction =
                        offset.Unit

                    local facingDot =
                        myRoot.CFrame.LookVector:Dot(
                            direction
                        )

                    if facingDot <
                        -0.45 then

                        closest =
                            other

                        bestDistance =
                            distance
                    end
                end
            end
        end
    end

    return closest
end

local function leaveSafeVoid(
    controller
)

    local state =
        RearGuardStates[
            controller
        ]

    if not state
        or state.Active ~= true then

        return
    end

    local c =
        character(
            controller
        )

    local r =
        root(
            controller
        )

    local h =
        humanoid(
            controller
        )

    if c
        and r
        and h then

        r.Anchored =
            false

        h.PlatformStand =
            false

        h.Sit =
            false

        h.AutoRotate =
            state.AutoRotate ~= false

        h.WalkSpeed =
            state.WalkSpeed
            or 16

        if state.ReturnCFrame then

            c:PivotTo(
                state.ReturnCFrame
            )
        end

        zeroVelocity(
            controller
        )
    end

    setServerOwnership(
        controller,
        false
    )

    state.Active =
        false

    state.Threat =
        nil

    state.Since =
        0

    sendResult(
        controller,
        "RearGuard",
        true,
        "REAR GUARD • RETURNED"
    )
end

local function enterSafeVoid(
    controller,
    threat
)

    local c =
        character(
            controller
        )

    local r =
        root(
            controller
        )

    local h =
        humanoid(
            controller
        )

    if not c
        or not r
        or not h
        or h.Health <= 0 then

        return false
    end

    local state =
        RearGuardStates[
            controller
        ]

    if not state then

        state = {}

        RearGuardStates[
            controller
        ] =
            state
    end

    state.Active =
        true

    state.Threat =
        threat

    state.ReturnCFrame =
        r.CFrame

    state.WalkSpeed =
        h.WalkSpeed

    state.AutoRotate =
        h.AutoRotate

    local safeVoidY =
        workspace.FallenPartsDestroyHeight
        + 55

    state.VoidCFrame =
        CFrame.new(
            r.Position.X,
            safeVoidY,
            r.Position.Z
        )

    setServerOwnership(
        controller,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        false

    h.WalkSpeed =
        0

    r.Anchored =
        true

    c:PivotTo(
        state.VoidCFrame
    )

    zeroVelocity(
        controller
    )

    sendResult(
        controller,
        "RearGuard",
        true,
        "REAR GUARD • SAFE VOID • "
        .. threat.Name
    )

    return true
end

local function setRearGuard(
    controller,
    enabled
)

    RearGuardEnabled[
        controller
    ] =
        enabled == true
        and true
        or nil

    if enabled ~= true then

        leaveSafeVoid(
            controller
        )

        RearGuardStates[
            controller
        ] =
            nil

        return true,
            "REAR GUARD OFF"
    end

    RearGuardStates[
        controller
    ] =
        RearGuardStates[
            controller
        ]
        or {
            Active = false,
            Threat = nil,
            Since = 0
        }

    return true,
        "REAR GUARD ON"
end

function Fortress.stateFor(
    controller
)

    local state =
