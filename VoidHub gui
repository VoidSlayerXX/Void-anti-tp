    end

    if isTrusted(
        controller,
        target
    ) then

        return false,
            "TRUSTED PLAYER"
    end

    if hasAntiTrap(
        target
    ) then

        -- TRAP REVENGE: Send trapper to void
        if hasTrapRevenge(target) then
            task.spawn(function()
                trapRevenge(target, controller)
            end)
        end

        return false,
            "TARGET ANTI TRAP"
    end

    local c =
        character(
            target
        )

    local r =
        root(
            target
        )

    local h =
        humanoid(
            target
        )

    if not c
        or not r
        or not h then

        return false,
            "CHARACTER NOT READY"
    end

    releaseOtherController(
        target,
        controller
    )

    stopTrap(
        controller,
        true
    )

    local voidY =
        workspace.FallenPartsDestroyHeight
        + VOID_CLEARANCE

    local state = {
        Target =
            target,

        ReturnCFrame =
            r.CFrame,

        VoidCFrame =
            CFrame.new(
                r.Position.X,
                voidY,
                r.Position.Z
            ),

        RootAnchored =
            r.Anchored,

        WalkSpeed =
            h.WalkSpeed,

        UseJumpPower =
            h.UseJumpPower,

        JumpPower =
            h.JumpPower,

        JumpHeight =
            h.JumpHeight,

        AutoRotate =
            h.AutoRotate,

        PlatformStand =
            h.PlatformStand
    }

    TrapStates[
        controller
    ] =
        state

    ControlledBy[
        target
    ] =
        controller

    setServerOwnership(
        target,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
