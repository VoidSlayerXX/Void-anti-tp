                    {}

                triggerCount =
                    0

                lastSignature =
                    ""

                lastTriggerAt =
                    -100

                lastMatchedIncident =
                    nil

                _G.VoidHubUITrigger =
                    nil

                status.Text =
                    enabled
                    and "Status: ON • triggers cleared"
                    or "Status: OFF • triggers cleared"

                render()
            end)

            RunService.Heartbeat:Connect(function()

                local trigger =
                    _G.VoidHubUITrigger

                if type(
                    trigger
                ) ~= "table"
                    or not trigger.Row then

                    return
                end

                local row =
                    trigger.Row

                if trigger.MatchedIncidentId
                    and row.IncidentId ~=
                        trigger.MatchedIncidentId then

                    row.IncidentId =
                        trigger.MatchedIncidentId

                    row.Level =
                        trigger.MatchedLevel

                    row.Delay =
                        trigger.MatchedDelay

                    status.Text =
                        "Status: CORRELATED • UI → "
                        .. tostring(
                            row.Level
                            or "incident"
                        )
                        .. " #"
                        .. tostring(
                            row.IncidentId
                        )

                    lastMatchedIncident =
                        row.IncidentId

                    render()
                end
            end)

            scanAll()

            render()
        end)

    if not ok then

        warn(
            "VOID HUB UI TRIGGER WATCH ERROR: "
            .. tostring(
                err
            )
        )
    end
end



