RunService.Heartbeat:Connect(function(dt)

    if not State.AutoClick then

        return
    end

    Extra.AutoClickAcc +=
        dt

    local interval =
        1
        /
        math.max(
            Extra.AutoClickCPS,
            1
        )

    if Extra.AutoClickAcc <
        interval then

        return
    end

    local clicksDue =
        math.clamp(
            math.floor(
                Extra.AutoClickAcc
                /
                interval
            ),
            1,
            1
        )

    Extra.AutoClickAcc =
        math.max(
            0,
            Extra.AutoClickAcc
            - (
                interval
                * clicksDue
            )
        )

    local clickWorked =
        false

    for _ =
        1,
        clicksDue do

        if Extra.performAutoClick() then

            clickWorked =
                true
        end
    end

    if clickWorked then

        Extra.AutoClickFailures =
            0

    else

        Extra.AutoClickFailures +=
            1

        if Extra.AutoClickFailures >=
            3 then

            State.AutoClick =
                false

            toggleText(
                Extra.AutoClickButton,
                "AUTO CLICK",
                false
            )

            PvPStatus.Text =
                "STATUS • AUTO CLICK INPUT NOT AVAILABLE"
        end
    end
end)

