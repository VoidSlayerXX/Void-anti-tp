    0

local rearGuardAccumulator =
    0

local fortressAccumulator =
    0

local antiVoidRescueAccumulator =
    0

local antiGymBanAccumulator =
    0

RunService.Heartbeat:Connect(function(dt)

    trapAccumulator +=
        dt

    antiGrabAccumulator +=
        dt

    grabReversalAccumulator +=
        dt

    zigZagAccumulator +=
        dt

    rearGuardAccumulator +=
        dt

    fortressAccumulator +=
        dt

    antiVoidRescueAccumulator +=
        dt

    antiGymBanAccumulator +=
        dt

    if trapAccumulator >=
        TRAP_UPDATE_RATE then

        trapAccumulator =
            0

        for controller,
            state in pairs(
                TrapStates
            ) do

            local target =
                state.Target

            if not controller
                or controller.Parent ~=
                    Players
                or not target
                or target.Parent ~=
                    Players then

                stopTrap(
                    controller,
                    false
                )

            elseif hasAntiTrap(
                target
            ) then

                stopTrap(
                    controller,
                    true
                )

                sendResult(
                    controller,
                    "Trap",
                    false,
                    "TARGET ANTI TRAP"
                )

            elseif not alive(
                target
            ) then

                stopTrap(
                    controller,
                    false
                )

            else

                local c =
                    character(
                        target
                    )

                local r =
                    root(
                        target
                    )

                local h =
                    humanoid(
                        target
                    )

                if c
                    and r
                    and h then

                    h.Sit =
                        false

                    h.PlatformStand =
                        false

                    h.AutoRotate =
                        false

                    h.WalkSpeed =
                        0

                    if h.UseJumpPower then
                        h.JumpPower =
                            0
                    else
                        h.JumpHeight =
                            0
                    end

                    r.Anchored =
                        true

                    c:PivotTo(
                        state.VoidCFrame
                    )

                    zeroVelocity(
                        target
                    )
                end
            end
        end
    end

    if antiGrabAccumulator >=
        0.12 then

        antiGrabAccumulator =
            0

        for _, protectedPlayer in ipairs(
            Players:GetPlayers()
        ) do

            if hasAntiGrab(
                protectedPlayer
            ) then

                clearGrabState(
                    protectedPlayer
                )
            end
        end
    end

    -- GRAB REVERSAL CHECK
    if grabReversalAccumulator >=
        0.1 then

        grabReversalAccumulator =
            0

        for _, protectedPlayer in ipairs(
            Players:GetPlayers()
        ) do

            if hasGrabReversal(
                protectedPlayer
            ) then

                local grabber =
                    findGrabber(
                        protectedPlayer
                    )

                if grabber then

                    teleportGrabberToVoid(
                        protectedPlayer,
                        grabber
                    )

                elseif isAuthorized(
                    protectedPlayer
                ) then

                    runOutgoingGrabReversal(
                        protectedPlayer
                    )
                end
            end
        end
    end

    if zigZagAccumulator >=
        0.08 then

        zigZagAccumulator =
            0

        for controller,
            state in pairs(
                ZigZagStates
            ) do

            local target =
                state.Target

            if not controller
                or controller.Parent ~= Players
                or not target
                or target.Parent ~= Players
                or not alive(
                    controller
                )
                or not alive(
                    target
                ) then

                ZigZagStates[
                    controller
                ] =
                    nil

            else

                local controllerChar =
                    character(
                        controller
                    )

                local controllerRoot =
                    root(
                        controller
                    )

                local targetRoot =
                    root(
                        target
                    )

                local controllerHumanoid =
                    humanoid(
                        controller
                    )

                if controllerChar
                    and controllerRoot
                    and targetRoot
                    and controllerHumanoid then

                    state.Side =
                        state.Side == 1
                        and -1
                        or 1

                    local destinationPosition =
                        (
                            targetRoot.CFrame
                            *
                            CFrame.new(
                                state.Side * 3.4,
                                0,
                                4.2
                            )
                        ).Position

                    controllerHumanoid.Sit =
                        false

                    controllerHumanoid.PlatformStand =
                        false

                    controllerRoot.Anchored =
                        false

                    controllerChar:PivotTo(
                        CFrame.lookAt(
                            destinationPosition,
                            Vector3.new(
                                targetRoot.Position.X,
                                destinationPosition.Y,
                                targetRoot.Position.Z
                            )
                        )
                    )

                    zeroVelocity(
                        controller
                    )
                end
            end
        end
    end

    if rearGuardAccumulator >=
        0.12 then

        rearGuardAccumulator =
            0

        local now =
            os.clock()

        for controller in pairs(
            RearGuardEnabled
        ) do

            if not controller
                or controller.Parent ~= Players
                or not alive(
                    controller
                ) then

                RearGuardEnabled[
                    controller
                ] =
                    nil

                RearGuardStates[
                    controller
                ] =
                    nil

            else

                local state =
                    RearGuardStates[
                        controller
                    ]
                    or {
                        Active = false,
                        Threat = nil,
                        Since = 0
                    }

                RearGuardStates[
                    controller
                ] =
                    state

                if state.Active == true then

                    local threat =
                        state.Threat

                    if not threat
                        or threat.Parent ~= Players
                        or not alive(
                            threat
                        ) then

                        leaveSafeVoid(
                            controller
                        )

                    else

                        local c =
                            character(
                                controller
                            )

                        local r =
                            root(
                                controller
                            )

                        local h =
                            humanoid(
                                controller
                            )

                        if c
                            and r
                            and h
                            and state.VoidCFrame then

                            r.Anchored =
                                true

                            h.Sit =
                                false

                            h.PlatformStand =
                                false

                            h.WalkSpeed =
                                0

                            c:PivotTo(
                                state.VoidCFrame
                            )

                            zeroVelocity(
                                controller
                            )
                        end
                    end

                else

                    local threat =
                        findRearThreat(
                            controller
                        )

                    if threat then

                        if state.Threat ~=
                            threat then

                            state.Threat =
                                threat

                            state.Since =
                                now

                        elseif now
                            - (
                                state.Since
                                or now
                            )
                            >= 0.55 then

                            enterSafeVoid(
                                controller,
                                threat
                            )
                        end

                    else

                        state.Threat =
                            nil

                        state.Since =
                            0
                    end
                end
            end
        end
    end

    if fortressAccumulator >=
        0.10 then

        fortressAccumulator =
            0

        for controller in pairs(
            Fortress.Enabled
        ) do

            if controller
                and controller.Parent ==
                    Players then

                Fortress.runShield(
                    controller
                )
            end
        end
    end

    if antiVoidRescueAccumulator >=
        0.05 then

        antiVoidRescueAccumulator =
            0

        for controller in pairs(
            Fortress.AntiVoid
        ) do

            if controller
                and controller.Parent ==
                    Players then

                Fortress.runAntiVoid(
                    controller
                )
            end
        end
    end

    if antiGymBanAccumulator >=
        0.10 then
        antiGymBanAccumulator = 0
        for protectedPlayer in pairs(GymBanGuard.Enabled) do
            if protectedPlayer and protectedPlayer.Parent == Players then
                runAntiGymBan(protectedPlayer)
            end
        end
    end

    local detentionNow =
        os.clock()

    for target, controller in pairs(
        Detention.Active
    ) do

        if not target
            or target.Parent ~= Players
            or not controller
            or controller.Parent ~= Players then

            Detention.Active[target] = nil
            Detention.ReturnCFrame[target] = nil
            Detention.Destination[target] = nil
            Detention.LastEnforce[target] = nil

        elseif alive(target) then

            local destination =
                Detention.Destination[
                    target
                ]

            local targetRoot =
                root(
                    target
                )

            if destination
                and targetRoot then

                local distance =
                    (
                        targetRoot.Position
                        - destination.Position
                    ).Magnitude

                if distance > Detention.Radius
                    and detentionNow
                        - (
                            Detention.LastEnforce[
                                target
                            ]
                            or 0
                        )
                        >= Detention.EnforceInterval then

                    Detention.LastEnforce[
                        target
                    ] =
                        detentionNow

                    movePlayerServer(
                        target,
                        destination
                    )
                end
            end
        end
    end

    local prisonNow =
        os.clock()

    local prisonReleaseQueue =
        {}

    for target,
        state in pairs(
            VoidPrison.Active
        ) do

        if not target
            or target.Parent ~=
                Players
            or not state.Owner
            or state.Owner.Parent ~=
                Players then

            table.insert(
                prisonReleaseQueue,
                {
                    Target =
                        target,

                    Return =
                        target
                        and target.Parent ==
                            Players
                }
            )

        elseif prisonNow >=
            state.Expires then

            table.insert(
                prisonReleaseQueue,
                {
                    Target =
                        target,

                    Return =
                        true
                }
            )

        elseif alive(
            target
        ) then

            local targetRoot =
                root(
                    target
                )

            if targetRoot then

                local distance =
                    (
                        targetRoot.Position
                        - state.Center.Position
                    ).Magnitude

                if distance >
                    VoidPrison.EscapeRadius
                    or prisonNow
                        - (
                            state.LastEnforce
                            or 0
                        )
                        >= VoidPrison.EnforceInterval then

                    state.LastEnforce =
                        prisonNow

                    setServerOwnership(
                        target,
                        true
                    )

                    if distance >
                        VoidPrison.EscapeRadius then

                        positionInVoidPrison(
                            target,
                            state
                        )
                    else

                        zeroVelocity(
                            target
                        )
                    end
                end
            end
        end
    end

    for _,
        item in ipairs(
            prisonReleaseQueue
        ) do

        local target =
            item.Target

        if target
            and VoidPrison.Active[
                target
            ] then

            clearVoidPrisonInternal(
                target,
                item.Return,
                "VOID PRISON EXPIRED"
            )
        end
    end

    local currentTime =
        os.clock()

    for controller in pairs(
        KillAuraEnabled
    ) do

        local settings =
            settingsFor(
                controller
            )

        if currentTime
            - (
                LastAuraTick[
                    controller
                ]
                or 0
            )
            >= settings.AuraTick then

            LastAuraTick[
                controller
            ] =
                currentTime

            runKillAura(
                controller
            )
        end
    end
end)

local function moveRespawnedPlayerToController(
    target
)

    if not target
        or target.Parent ~= Players then

        return false
    end

    for controller,
        enabled in pairs(
            RespawnAtMeEnabled
        ) do

        if enabled == true
            and controller
            and controller.Parent == Players
            and controller ~= target
            and isAuthorized(
                controller
            )
            and alive(
                controller
            )
            and alive(
                target
            )
            and not isTrusted(
                controller,
                target
            )
            and not hasAntiBring(
                target
            ) then

            local controllerRoot =
                root(
                    controller
                )

            local targetCharacter =
                character(
                    target
                )

            local targetRoot =
                root(
                    target
                )

            local targetHumanoid =
                humanoid(
                    target
                )

            if controllerRoot
                and targetCharacter
                and targetRoot
                and targetHumanoid then

                setServerOwnership(
                    target,
                    true
                )

                targetHumanoid.Sit =
                    false

                targetHumanoid.PlatformStand =
                    false

                targetRoot.Anchored =
                    false

                targetCharacter:PivotTo(
                    controllerRoot.CFrame
                    *
                    CFrame.new(
                        0,
                        0,
                        -4
                    )
                )

                zeroVelocity(
                    target
                )

                task.delay(
                    0.25,
                    function()

                        if target
                            and target.Parent ==
                                Players then

                            setServerOwnership(
                                target,
                                false
                            )
                        end
                    end
                )

                return true
            end
        end
    end

    return false
end

local function hookPlayer(
    player
)

    loadSettings(
        player
    )

    if isAuthorized(
        player
    ) then

        local settings =
            settingsFor(
                player
            )

        if settings.AntiGymBan == true then
            player:SetAttribute("VoidHubAntiGymBan", true)
            GymBanGuard.Enabled[player] = true
            runAntiGymBan(player)
        end

        Fortress.Enabled[
            player
        ] =
            true

        Fortress.AntiVoid[
            player
        ] =
            true

        Fortress.Hitbox[
            player
        ] =
            true

        Fortress.stateFor(
            player
        )
    end

    task.defer(function()
        pcall(refreshProtected)
    end)

    player.CharacterRemoving:Connect(function(
        oldCharacter
    )

        if Fortress.AntiVoid[
            player
        ] ~= true then

            return
        end

        local oldRoot =
            oldCharacter
            and oldCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        local state =
            Fortress.State[
                player
            ]

        if oldRoot
            and oldRoot.Position.Y <=
                workspace.FallenPartsDestroyHeight
                + Fortress.AntiVoidMargin
                + 20
            and state
            and state.SafeCFrame then

            Fortress.PendingReturn[
                player
            ] =
                state.SafeCFrame
        end
    end)

    player.CharacterAdded:Connect(function()

        local isRespawn =
            HasSpawnedOnce[
                player
            ] == true

        HasSpawnedOnce[
            player
        ] =
            true

        task.wait(
            0.2
        )

        local activeVoidPrison =
            VoidPrison.Active[
                player
            ]

        if activeVoidPrison
            and os.clock() <
                activeVoidPrison.Expires then

            task.delay(
                0.05,
                function()

                    if VoidPrison.Active[
                        player
                    ] ==
                        activeVoidPrison then

                        positionInVoidPrison(
                            player,
                            activeVoidPrison
                        )
                    end
                end
            )
        end

        local settings =
            settingsFor(
                player
            )

        if settings.AutoCombatOffDeath then

            KillAuraEnabled[
                player
            ] =
                nil

            KillAuraTarget[
                player
            ] =
                nil

            LastAuraTick[
                player
            ] =
                nil

            if TrapStates[
                player
            ] then

                stopTrap(
                    player,
                    true
                )
            end
        end

        if hasAntiBring(
            player
        )
            or hasAntiTrap(
                player
            ) then

            releaseTarget(
                player
            )
        end

        if hasAntiGrab(
            player
        ) then

            clearGrabState(
                player
            )
        end

        applyProtected(
            player
        )

        if hasAntiGymBan(player) then
            runAntiGymBan(player)
            task.delay(0.35, function()
                runAntiGymBan(player)
            end)
        end

        if isAuthorized(
            player
        ) then

            Fortress.Enabled[
                player
            ] =
                true

            Fortress.AntiVoid[
                player
            ] =
                true

            Fortress.Hitbox[
                player
            ] =
                true

            local pendingReturn =
                Fortress.PendingReturn[
                    player
                ]

            if pendingReturn then

                Fortress.PendingReturn[
                    player
                ] =
                    nil

                task.delay(
                    0.20,
                    function()

                        local newCharacter =
                            character(
                                player
                            )

                        local newRoot =
                            root(
                                player
                            )

                        if newCharacter
                            and newRoot then

                            newCharacter:PivotTo(
                                pendingReturn
                            )

                            zeroVelocity(
                                player
                            )

                            Fortress.stateFor(
                                player
                            ).SafeCFrame =
                                pendingReturn

                            sendResult(
                                player,
                                "FortressRescue",
                                true,
                                "ANTI VOID • RESPAWN RETURN"
                            )
                        end
                    end
                )

            else

                task.delay(
                    0.25,
                    function()

                        Fortress.rememberSafe(
                            player
                        )
                    end
                )
            end
        end

        if isRespawn then

            task.delay(
                0.35,
                function()

                    moveRespawnedPlayerToController(
                        player
                    )
                end
            )
        end
    end)
end

