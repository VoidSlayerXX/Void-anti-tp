            "KILL AURA",
            State.KillAura
        )

        return
    end
end

function Extra.bindActionRemote()

    local remote =
        RS:FindFirstChild(
            "VoidHubAction"
        )

    if not remote
        or not remote:IsA(
            "RemoteEvent"
        ) then

        return false
    end

    ActionRemote =
        remote

    if Extra.ActionRemoteConnection then

        Extra.ActionRemoteConnection:Disconnect()

        Extra.ActionRemoteConnection =
            nil
    end

    Extra.ActionRemoteConnection =
        ActionRemote.OnClientEvent:Connect(
            Extra.onServerResult
        )

    return true
end

