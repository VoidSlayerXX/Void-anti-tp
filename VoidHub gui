function Fortress.zoneEject(
    controller,
    target
)

    if not controller
        or not target
        or controller == target
        or not alive(
            controller
        )
        or not alive(
            target
        )
        or isTrusted(
            controller,
            target
        ) then

        return false
    end

    local myRoot =
        root(
            controller
        )

    local targetCharacter =
        character(
            target
        )

    local targetRoot =
        root(
            target
        )

    local targetHumanoid =
        humanoid(
            target
        )

    if not myRoot
        or not targetCharacter
        or not targetRoot
        or not targetHumanoid then

        return false
    end

    local cooldowns =
        Fortress.ZoneCooldown[
            controller
        ]

    if not cooldowns then

        cooldowns = {}

        Fortress.ZoneCooldown[
            controller
        ] =
            cooldowns
    end

    local now =
        os.clock()

    if now
        - (
            cooldowns[
                target
            ]
            or 0
        )
        < Fortress.ExploitRepelCooldownTime then

        return false
    end

    cooldowns[
        target
    ] =
        now

    local offset =
        targetRoot.Position
        - myRoot.Position

    local flat =
        Vector3.new(
            offset.X,
            0,
            offset.Z
        )

    if flat.Magnitude <
        0.5 then

        local look =
            myRoot.CFrame.LookVector

        flat =
            Vector3.new(
                look.X,
                0,
                look.Z
            )
    end

    if flat.Magnitude <
        0.01 then

        flat =
            Vector3.new(
                1,
                0,
                0
            )
    end

    local direction =
        flat.Unit

    local heightOffset =
        math.clamp(
            targetRoot.Position.Y
                - myRoot.Position.Y,
            0,
            6
        )

    local destination =
        CFrame.new(
            myRoot.Position
            + direction
                * Fortress.ExploitEjectDistance
            + Vector3.new(
                0,
                heightOffset,
                0
            )
        )

    -- Break direct character links first so a grab/constraint cannot
    -- drag the protected player along with the intruder.
    breakGrabLinksBetween(
        controller,
        target
    )

    -- Temporarily make the server authoritative for the intruder,
    -- move them outside the perimeter, and erase carried momentum.
    setServerOwnership(
        target,
        true
    )

    targetHumanoid.Sit =
        false

    targetHumanoid.PlatformStand =
        false

    targetHumanoid.AutoRotate =
        true

    targetRoot.Anchored =
        false

    targetCharacter:PivotTo(
        destination
    )

    zeroVelocity(
        target
    )

    task.delay(
        0.40,
        function()

            if target
                and target.Parent ==
                    Players then

                setServerOwnership(
                    target,
                    false
                )
            end
        end
    )

    local state =
        Fortress.stateFor(
            controller
        )

    if now
        - (
            state.ZoneLastNoticeAt
            or 0
        )
        >= 0.9 then

        state.ZoneLastNoticeAt =
            now

        sendResult(
            controller,
            "FortressGuard",
            true,
            "ANTI EXPLOIT ZONE • EJECTED • "
            .. target.Name
        )
    end

    return true
end

function Fortress.runShield(
    controller
)

    if Fortress.Enabled[
        controller
    ] ~= true
        or not alive(
            controller
        ) then

        return
    end

    local myRoot =
        root(
            controller
        )

    if not myRoot then
        return
    end

    local state =
        Fortress.stateFor(
            controller
        )

    local now =
        os.clock()

    local previousCFrame =
        state.ZoneLastCFrame

    local threatFound =
        false

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= controller
            and alive(
                target
            )
            and not isTrusted(
                controller,
                target
            ) then

            local targetRoot =
                root(
                    target
                )

            if targetRoot then

                local distance =
                    (
                        targetRoot.Position
                        - myRoot.Position
                    ).Magnitude

                if distance <=
                    Fortress.ExploitRadius then

                    threatFound =
                        true

                    state.ZoneThreatUntil =
                        now
                        + Fortress.ExploitThreatHold

                    -- Preserve the original 9-stud SMART SHIELD:
                    -- somebody who gets this close is still sent away
                    -- using the existing repel behavior.
                    if distance <=
                        Fortress.Radius then

                        Fortress.repel(
                            controller,
                            target
                        )

                    else

                        -- Larger perimeter: server ejects them just
                        -- outside the zone. Fly/noclip do not bypass
                        -- this because collision is not relied on.
                        Fortress.zoneEject(
                            controller,
                            target
                        )
                    end
                end
            end
        end
    end

    local threatActive =
        threatFound
        or (
            (
                state.ZoneThreatUntil
                or 0
            ) > now
        )

    if threatActive then

        local currentRoot =
            root(
                controller
            )

        if currentRoot then

            local rescueY =
                workspace.FallenPartsDestroyHeight
                + Fortress.AntiVoidMargin

            if currentRoot.Position.Y <=
                rescueY then

                Fortress.rescue(
                    controller,
                    "ANTI EXPLOIT ZONE • VOID BLOCKED"
                )

            elseif previousCFrame then

                local forcedDistance =
                    (
                        currentRoot.Position
                        - previousCFrame.Position
                    ).Magnitude

                if forcedDistance >=
                    Fortress.ExploitTeleportThreshold then

                    Fortress.rescue(
                        controller,
                        "ANTI EXPLOIT ZONE • FORCED TP BLOCKED"
                    )
                end
            end

            currentRoot =
                root(
                    controller
                )

            if currentRoot then

                if currentRoot.AssemblyLinearVelocity.Magnitude >=
                    Fortress.ExploitVelocityThreshold
                    or currentRoot.AssemblyAngularVelocity.Magnitude >=
                        Fortress.ExploitAngularThreshold then

                    zeroVelocity(
                        controller
                    )
                end
            end
        end

    else

        -- Only learn new rescue positions while the perimeter is calm.
        Fortress.rememberSafe(
            controller
        )
    end

    local finalRoot =
        root(
            controller
        )

    if finalRoot then

        state.ZoneLastCFrame =
            finalRoot.CFrame
    end
end

function Fortress.meleePulse(
    controller,
    preferredTarget
)

    if Fortress.Hitbox[
        controller
    ] ~= true
        or not alive(
            controller
        ) then

        return false,
            "MELEE HITBOX OFF"
    end

    local now =
        os.clock()

    if now
        - (
            Fortress.MeleeCooldown[
                controller
            ]
            or 0
        )
        < 0.16 then

        return false,
            "MELEE COOLDOWN"
    end

    Fortress.MeleeCooldown[
        controller
    ] =
        now

    local myRoot =
        root(
            controller
        )

    if not myRoot then

        return false,
            "CHARACTER NOT READY"
    end

    local target =
        preferredTarget

    local function validTarget(
        candidate
    )

        if not candidate
            or candidate == controller
            or not alive(
                candidate
            )
            or isTrusted(
                controller,
                candidate
            )
            or not pvpAllowed(
                controller
            )
            or not pvpAllowed(
                candidate
            ) then

            return false
        end

        local targetRoot =
            root(
                candidate
            )

        if not targetRoot then
            return false
        end

        local offset =
            targetRoot.Position
            - myRoot.Position

        local distance =
            offset.Magnitude

        if distance >
            Fortress.MeleeReach
            or distance < 0.05 then

            return false
        end

        local facing =
            myRoot.CFrame.LookVector:Dot(
                offset.Unit
            )

        return facing >=
            -0.15
    end

    if not validTarget(
        target
    ) then

        target =
            nil

        local bestDistance =
            Fortress.MeleeReach

        for _, candidate in ipairs(
            Players:GetPlayers()
        ) do

            if validTarget(
                candidate
            ) then

                local targetRoot =
                    root(
                        candidate
                    )

                local distance =
                    (
                        targetRoot.Position
                        - myRoot.Position
                    ).Magnitude

                if distance <
                    bestDistance then

                    bestDistance =
                        distance

                    target =
                        candidate
                end
            end
        end
    end

    if not target then

        return false,
            "NO TARGET IN MELEE REACH"
    end

    local targetHumanoid =
        humanoid(
            target
        )

    if not targetHumanoid then

        return false,
            "TARGET NOT READY"
    end

    targetHumanoid:TakeDamage(
        Fortress.MeleeDamage
    )

    return true,
        "MELEE HIT • "
        .. target.Name
end

