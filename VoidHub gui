        ProtectionDash.Text =
            "Protection: "
            .. (
                State.AntiBring
                    and "ANTI BRING ON"
                    or "ANTI BRING OFF"
            )

        if Extra.AntiBringBadge then

            Extra.AntiBringBadge.Text =
                "ANTI BRING: "
                .. (
                    State.AntiBring
                    and "ON"
                    or "OFF"
                )
        end

        return
    end

    if action ==
        "SetAntiTrap" then

        ProtectionStatus.Text =
            "Protection status: "
            .. tostring(
                message
                or (
                    State.AntiTrap
                    and "ANTI TRAP ON"
                    or "ANTI TRAP OFF"
                )
            )

        ProtectionDash.Text =
            "Protection: "
            .. (
                State.AntiTrap
                    and "ANTI TRAP ON"
                    or "ANTI TRAP OFF"
            )

        if Extra.AntiTrapBadge then

            Extra.AntiTrapBadge.Text =
                "ANTI TRAP: "
                .. (
                    State.AntiTrap
                    and "ON"
                    or "OFF"
                )
        end

        return
    end

    if action ==
        "SetAntiGrab" then

        ProtectionStatus.Text =
            "Protection status: "
            .. tostring(
                message
                or (
                    State.AntiGrab
                    and "ANTI GRAB ON"
                    or "ANTI GRAB OFF"
                )
            )

        ProtectionDash.Text =
            "Protection: "
            .. (
                State.AntiGrab
                    and "ANTI GRAB ON"
                    or "ANTI GRAB OFF"
            )

        return
    end

    if action ==
        "SetGrabReversal" then

        if ok ~= true then

            State.GrabReversal =
                false

            toggleText(
                Extra.ProtectionButtons["GrabReversal"],
                "GRAB REVERSAL",
                false
            )

            ClientGrabReversal.Enabled =
                false
        end

        ProtectionStatus.Text =
            "Protection status: "
            .. tostring(
                message
                or (
                    State.GrabReversal
                    and "GRAB REVERSAL ON"
                    or "GRAB REVERSAL OFF"
                )
            )

        return
    end

    if action ==
        "SetRespawnAtMe" then

        if ok ~= true then

            State.SpawnAtMe =
                false

            toggleText(
                Extra.SpawnAtMeButton,
                "SPAWN AT ME",
