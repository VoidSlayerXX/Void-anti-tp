function Extra.playerHasOGxTag(
    targetPlayer
)

    if not targetPlayer then
        return false
    end

    local tag =
        Extra.WatchClanTag

    local function containsTag(
        value
    )

        return type(value) ==
            "string"
            and string.find(
                string.lower(
                    value
                ),
                tag,
                1,
                true
            ) ~= nil
    end

    if containsTag(
        targetPlayer.Name
    )
        or containsTag(
            targetPlayer.DisplayName
        ) then

        return true
    end

    if targetPlayer.Team
        and containsTag(
            targetPlayer.Team.Name
        ) then

        return true
    end

    local attributeNames = {
        "Clan",
        "ClanName",
        "ClanTag",
        "Group",
        "GroupName",
        "Crew",
        "CrewName",
        "Guild",
        "GuildName",
        "Faction",
        "FactionName",
        "Tag"
    }

    for _, attributeName in ipairs(
        attributeNames
    ) do

        if containsTag(
            targetPlayer:GetAttribute(
                attributeName
            )
        ) then

            return true
        end
    end

    for _, child in ipairs(
        targetPlayer:GetChildren()
    ) do

        if child:IsA(
            "StringValue"
        )
            and containsTag(
                child.Value
            ) then

            return true
        end
    end

    return false
end

