            LastRescueAt = 0,
            LastRepelAt = 0,

            -- Anti-exploit zone tracking.
            ZoneLastCFrame = nil,
            ZoneThreatUntil = 0,
            ZoneLastNoticeAt = 0
        }

        Fortress.State[
            controller
        ] =
            state
    end

    return state
end

