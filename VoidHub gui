function Fortress.repel(
    controller,
    target
)

    if not controller
        or not target
        or controller == target
        or not alive(
            target
        )
        or isTrusted(
            controller,
            target
        ) then

        return false
    end

    local cooldowns =
        Fortress.RepelCooldown[
            controller
        ]

    if not cooldowns then

        cooldowns = {}

        Fortress.RepelCooldown[
            controller
        ] =
            cooldowns
    end

    local now =
        os.clock()

    if now
        - (
            cooldowns[
                target
            ]
            or 0
        )
        < Fortress.RepelCooldownTime then

        return false
    end

    cooldowns[
        target
    ] =
        now

    breakGrabLinksBetween(
        controller,
        target
    )

    local moved =
        teleportPlayerToClassroom(
            target
        )

    if moved then

        zeroVelocity(
            controller
        )

        sendResult(
            controller,
            "FortressGuard",
            true,
            "SMART SHIELD • REPELLED • "
            .. target.Name
        )
    end

    return moved
end

