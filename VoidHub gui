local function classroomNameMatch(
    instance
)

    local current =
        instance

    local depth =
        0

    while current
        and current ~= workspace
        and depth < 6 do

        local lower =
            string.lower(
                tostring(
                    current.Name
                )
            )

        if string.find(
            lower,
            "classroom",
            1,
            true
        )
            or string.find(
                lower,
                "class room",
                1,
                true
            )
            or string.find(
                lower,
                "class_",
                1,
                true
            )
            or string.find(
                lower,
                "class-",
                1,
                true
            )
            or string.sub(
                lower,
                1,
                5
            ) == "class" then

            return true
        end

        current =
            current.Parent

        depth +=
            1
    end

    return false
end

local function refreshClassroomPoints()

    local now =
        os.clock()

    if now <
        ClassroomPointCache.RefreshAt
        and (
            #ClassroomPointCache.Preferred > 0
            or #ClassroomPointCache.Fallback > 0
        ) then

        return
    end

    ClassroomPointCache.Preferred =
        {}

    ClassroomPointCache.Fallback =
        {}

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA(
            "BasePart"
        )
            and object.Anchored
            and object.CanCollide
            and classroomNameMatch(
                object
            ) then

            local lower =
                string.lower(
                    object.Name
                )

            local preferred =
                string.find(
                    lower,
                    "spawn",
                    1,
                    true
                )
                or string.find(
                    lower,
                    "teleport",
                    1,
                    true
                )
                or string.find(
                    lower,
                    "center",
                    1,
                    true
                )
                or string.find(
                    lower,
                    "floor",
                    1,
                    true
                )
                or string.find(
                    lower,
                    "entrance",
                    1,
                    true
                )
                or (
                    object.Size.X >= 8
                    and object.Size.Z >= 8
                )

            if preferred then

                ClassroomPointCache.Preferred[
                    #ClassroomPointCache.Preferred + 1
                ] =
                    object

            else

                ClassroomPointCache.Fallback[
                    #ClassroomPointCache.Fallback + 1
                ] =
                    object
            end
        end
    end

    ClassroomPointCache.RefreshAt =
        now
        + 30
end

local function classroomTeleportCFrame(
    targetPlayer
)

    refreshClassroomPoints()

    local list =
        #ClassroomPointCache.Preferred > 0
        and ClassroomPointCache.Preferred
        or ClassroomPointCache.Fallback

    local count =
        #list

    if count > 0 then

        local seed =
            (
                targetPlayer.UserId
                + math.floor(
                    os.clock()
                    * 10
                )
            )
            % count

        local part =
            list[
                seed + 1
            ]

        if part
            and part.Parent then

            return
                part.CFrame
                *
                CFrame.new(
                    0,
                    math.max(
                        4,
                        part.Size.Y * 0.5 + 3
                    ),
                    0
                )
        end
    end

    -- Fallback: a real SpawnLocation is safer than leaving the grabber
    -- attached to the protected player if the map has no recognizable
    -- classroom names.
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA(
            "SpawnLocation"
        ) then

            return
                object.CFrame
                *
                CFrame.new(
                    0,
                    4,
                    0
                )
        end
    end

    return nil
end

local function teleportPlayerToClassroom(
    targetPlayer
)

    if not targetPlayer
        or not alive(
            targetPlayer
        ) then

        return false
    end

    local c =
        character(
            targetPlayer
        )

    local r =
        root(
            targetPlayer
        )

    local h =
        humanoid(
            targetPlayer
        )

    local destination =
        classroomTeleportCFrame(
