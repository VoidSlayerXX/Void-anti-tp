setServerOwnership = function(
    player,
    serverOwned
)

    local c =
        character(
            player
        )

    if not c then
        return
    end

    for _, object in ipairs(
        c:GetDescendants()
    ) do

        if object:IsA(
            "BasePart"
        )
            and not object.Anchored then

            pcall(function()

                if serverOwned then

                    object:SetNetworkOwner(
                        nil
                    )

                else

                    object:SetNetworkOwnershipAuto()
                end
            end)
        end
    end
end

local function stopTrap(
    controller,
    restorePosition
)

    local state =
        TrapStates[
            controller
        ]

    if not state then
        return
    end

    TrapStates[
        controller
    ] =
        nil

    local target =
        state.Target

    if target then
        ControlledBy[
            target
        ] =
            nil
    end

    if not target
        or target.Parent ~=
            Players then

        return
    end

    local c =
        character(
            target
        )

    local r =
        root(
            target
        )

    local h =
        humanoid(
            target
        )

    if r then
        r.Anchored =
            false
    end

    if restorePosition
        and c
        and state.ReturnCFrame then

        c:PivotTo(
            state.ReturnCFrame
        )

        zeroVelocity(
            target
        )
    end

    if h then

        h.AutoRotate =
            state.AutoRotate

        h.PlatformStand =
            state.PlatformStand

        h.WalkSpeed =
            state.WalkSpeed

        h.UseJumpPower =
            state.UseJumpPower

        h.JumpPower =
            state.JumpPower

        h.JumpHeight =
            state.JumpHeight

        h.Sit =
            false
    end

    if r then

        r.Anchored =
            state.RootAnchored
    end

    setServerOwnership(
        target,
        false
    )
end

local function releaseTarget(
    target
)

    local controller =
        ControlledBy[
            target
        ]

    if controller then

        stopTrap(
            controller,
            true
        )
    end
end

