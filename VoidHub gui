local function findGrabber(player)

    if not player
        or not hasGrabVictimEvidence(
            player
        ) then

        return nil
    end

    local linked =
        findCrossCharacterLinkedPlayer(
            player
        )

    if linked then

        return linked
    end

    -- Some games expose only victim state, without a visible joint.
    local myRoot =
        root(
            player
        )

    if not myRoot then

        return nil
    end

    local closest
    local closestDist =
        18

    for _, otherPlayer in ipairs(
        Players:GetPlayers()
    ) do

        if otherPlayer ~= player then

            local otherRoot =
                root(
                    otherPlayer
                )

            if otherRoot then

                local dist =
                    (
                        otherRoot.Position
                        - myRoot.Position
                    ).Magnitude

                if dist <
                    closestDist then

                    closestDist =
                        dist

                    closest =
                        otherPlayer
                end
            end
        end
    end

    return closest
end



local function teleportGrabberToVoid(
    protectedPlayer,
    grabber
)

    if not protectedPlayer
        or not grabber
        or protectedPlayer == grabber then

        return false
    end

    if not hasGrabReversal(
        protectedPlayer
    ) then

        return false
    end

    local now =
        os.clock()

    if now
        - (
            LastGrabReversal[
                protectedPlayer
            ]
            or 0
        )
        < GRAB_REVERSAL_COOLDOWN then

        return false
    end

    LastGrabReversal[
        protectedPlayer
    ] =
        now

    breakGrabLinksBetween(
        protectedPlayer,
        grabber
    )

    local moved =
        teleportPlayerToClassroom(
            grabber
        )

    clearGrabState(
        protectedPlayer
    )

    task.wait(
        0.05
    )

    returnProtectedToSafe(
        protectedPlayer
    )

    sendResult(
        protectedPlayer,
        "GrabReversal",
        moved,
        moved
            and (
                "ANTI GRAB • GRABBER CLASSROOM-TP • "
                .. grabber.Name
            )
            or "ANTI GRAB • CLASSROOM-TP FAILED"
    )

    return moved
end


local function runOutgoingGrabReversal(
    controller
)

    if not controller
        or not isAuthorized(
            controller
        )
        or not hasGrabReversal(
            controller
        )
        or hasGrabVictimEvidence(
            controller
        ) then

        return false
    end

    local target =
        findCrossCharacterLinkedPlayer(
            controller
        )

    if not target
        or target == controller
        or not alive(
            target
        )
        or isTrusted(
            controller,
            target
        ) then

        return false
    end

    local now =
        os.clock()

    if now
        - (
            AntiGrabGuard.OutgoingCooldown[
                controller
            ]
            or 0
        )
        < 0.55 then

        return false
    end

    AntiGrabGuard.OutgoingCooldown[
        controller
    ] =
        now

    AntiGrabGuard.LastOutgoingTarget[
        controller
    ] =
        target

    breakGrabLinksBetween(
        controller,
        target
    )

    local killed =
        voidKillPlayer(
            target
        )

    returnProtectedToSafe(
        controller
    )

    sendResult(
        controller,
        "GrabReversal",
        killed,
        killed
            and (
                "GRAB REVERSAL • TARGET VOID-KILLED • "
                .. target.Name
            )
            or "GRAB REVERSAL • TARGET FAILED"
    )

    return killed
end

