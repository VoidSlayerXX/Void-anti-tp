                rawText
            )

                if not enabled then
                    return
                end

                local now =
                    os.clock()

                local clean =
                    tostring(
                        rawText
                        or ""
                    )

                local signature =
                    normalize(
                        clean
                    )

                if signature ==
                    lastSignature
                    and now
                        - lastTriggerAt <
                            0.75 then

                    return
                end

                lastSignature =
                    signature

                lastTriggerAt =
                    now

                triggerCount +=
