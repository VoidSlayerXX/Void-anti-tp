local function detentionNameMatch(instance)
    local current = instance
    local depth = 0

    while current and current ~= workspace and depth < 7 do
        local lower = string.lower(tostring(current.Name))

        if string.find(lower, "detention", 1, true)
            or string.find(lower, "detention room", 1, true)
            or string.find(lower, "detention_room", 1, true)
            or string.find(lower, "detention-", 1, true) then

            return true
        end

        current = current.Parent
        depth += 1
    end

    return false
end

local function detentionDestination(targetPlayer)
    local preferred = {}
    local fallback = {}

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("BasePart")
            and object.Anchored
            and object.CanCollide
            and detentionNameMatch(object) then

            local lower = string.lower(tostring(object.Name))

            local good =
                string.find(lower, "spawn", 1, true)
                or string.find(lower, "seat", 1, true)
                or string.find(lower, "center", 1, true)
                or string.find(lower, "floor", 1, true)
                or string.find(lower, "teleport", 1, true)
                or (object.Size.X >= 6 and object.Size.Z >= 6)

            table.insert(good and preferred or fallback, object)
        end
    end

    local list = #preferred > 0 and preferred or fallback

    if #list > 0 then
        local index = (math.abs(targetPlayer.UserId) % #list) + 1
        local part = list[index]

        return part.CFrame * CFrame.new(
            0,
            math.max(4, part.Size.Y * 0.5 + 3),
            0
        )
    end

    -- Safe fallback if this place does not yet contain a Detention object.
    return classroomTeleportCFrame(targetPlayer)
end

local function movePlayerServer(targetPlayer, destination)
    if not targetPlayer
        or not alive(targetPlayer)
        or typeof(destination) ~= "CFrame" then
        return false
    end

    local c = character(targetPlayer)
    local r = root(targetPlayer)
    local h = humanoid(targetPlayer)

    if not c or not r or not h then
        return false
    end

    setServerOwnership(targetPlayer, true)

    h.Sit = false
    h.PlatformStand = false
    h.AutoRotate = true
    r.Anchored = false

    c:PivotTo(destination)
    zeroVelocity(targetPlayer)

    task.delay(0.35, function()
        if targetPlayer and targetPlayer.Parent == Players then
            setServerOwnership(targetPlayer, false)
        end
    end)

    return true
end

local function detainPlayer(controller, target)
    if not controller
        or not target
        or controller == target
        or not isAuthorized(controller)
        or not alive(target) then

        return false, "INVALID DETENTION TARGET"
    end

    if isTrusted(controller, target) then
        return false, "TRUSTED PLAYER SKIPPED"
    end

    local targetRoot = root(target)
    local destination = detentionDestination(target)

    if not targetRoot or not destination then
        return false, "DETENTION LOCATION NOT FOUND"
    end

    if not Detention.Active[target] then
        Detention.ReturnCFrame[target] = targetRoot.CFrame
    end

    Detention.Active[target] = controller
    Detention.Destination[target] = destination

    if not movePlayerServer(target, destination) then
        Detention.Active[target] = nil
        Detention.Destination[target] = nil
        return false, "DETENTION TELEPORT FAILED"
    end

    return true, "DETAINED • " .. target.Name
end

local function releaseDetainedPlayer(controller, target)
    if not controller
        or not isAuthorized(controller)
        or not target then

        return false, "INVALID RELEASE TARGET"
    end

    if not Detention.Active[target] then
        return false, "PLAYER IS NOT DETAINED"
    end

    local returnCF = Detention.ReturnCFrame[target]

    Detention.Active[target] = nil
    Detention.Destination[target] = nil
    Detention.LastEnforce[target] = nil
    Detention.ReturnCFrame[target] = nil

    if returnCF and alive(target) then
        movePlayerServer(target, returnCF)
    end

    return true, "RELEASED • " .. target.Name
end

local function detainAllPlayers(controller)
    if not controller or not isAuthorized(controller) then
        return false, "NOT AUTHORIZED"
    end

    local count = 0

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= controller
            and alive(target)
            and not isTrusted(controller, target) then

            local ok = detainPlayer(controller, target)
            if ok then
                count += 1
            end
        end
    end

    return count > 0,
        count > 0
            and ("DETAIN ALL • " .. tostring(count) .. " PLAYER" .. (count == 1 and "" or "S"))
            or "NO ELIGIBLE PLAYERS"
end

local function releaseAllDetained(controller)
    if not controller or not isAuthorized(controller) then
        return false, "NOT AUTHORIZED"
    end

    local targets = {}

    for target, owner in pairs(Detention.Active) do
        if owner == controller then
            table.insert(targets, target)
        end
    end

    local count = 0

    for _, target in ipairs(targets) do
        local ok = releaseDetainedPlayer(controller, target)
        if ok then
            count += 1
        end
    end

    return true,
        "RELEASE ALL • " .. tostring(count) .. " PLAYER" .. (count == 1 and "" or "S")
end



