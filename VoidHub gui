--==============================================================

local AntiTPBypassUntil = 0
local AntiTPLastPosition
local AntiTPLastCFrame
local AntiTPLastTime = os.clock()

local function syncAntiTP()

    local r =
        root()

    if r then

        AntiTPLastPosition =
            r.Position

        AntiTPLastCFrame =
            r.CFrame

        AntiTPLastTime =
            os.clock()
    end
end

local function teleportSelf(cf)

    local c =
        character()

    local r =
        root()

    local h =
        humanoid()

    if not c
        or not r
        or not h
        or typeof(cf) ~= "CFrame" then

        return false
    end

    AntiTPBypassUntil =
        os.clock()
        + 1.5

    h.Sit =
        false

    h.PlatformStand =
        false

    zeroVelocity()

    c:PivotTo(
        cf
    )

    zeroVelocity()

    local remote =
        RS:FindFirstChild(
            "VoidHubAction"
        )

    if remote
        and remote:IsA(
            "RemoteEvent"
        ) then

        remote:FireServer(
            "SafeTeleport",
            nil,
            cf,
            0
        )
    end

    syncAntiTP()

    return true
end

