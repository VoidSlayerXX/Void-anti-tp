local function findCrossCharacterLinkedPlayer(
    player
)

    if not player then

        return nil
    end

    local c =
        character(
            player
        )

    if not c then

        return nil
    end

    for _, otherPlayer in ipairs(
        Players:GetPlayers()
    ) do

        if otherPlayer ~= player
            and otherPlayer.Character then

            local otherChar =
                otherPlayer.Character

            -- Link object parented to our own character.
            for _, object in ipairs(
                c:GetDescendants()
            ) do

                if externalJointTouchesCharacter(
                    object,
                    c
                )
                    and jointTouchesCharacter(
                        object,
                        otherChar
                    ) then

                    return otherPlayer
                end
            end

            -- Link object parented to the other character.
            for _, object in ipairs(
                otherChar:GetDescendants()
            ) do

                if externalJointTouchesCharacter(
                    object,
                    c
                )
                    and jointTouchesCharacter(
                        object,
                        otherChar
                    ) then

                    return otherPlayer
                end
            end
        end
    end

    return nil
end

local function breakGrabLinksBetween(
    aPlayer,
    bPlayer
)

    local aChar =
        character(
            aPlayer
        )

    local bChar =
        character(
            bPlayer
        )

    if not aChar
        or not bChar then

        return
    end

    local function scan(
        container
    )

        for _, object in ipairs(
            container:GetDescendants()
        ) do

            if externalJointTouchesCharacter(
                object,
                aChar
            )
                and jointTouchesCharacter(
                    object,
                    bChar
                ) then

                pcall(function()
                    object:Destroy()
                end)
            end
        end
    end

    scan(
        aChar
    )

    scan(
        bChar
    )
end

