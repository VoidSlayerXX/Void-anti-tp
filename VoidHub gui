        -- The server itself decides who is inside the radius each tick.
        KillAuraTarget[
            controller
        ] =
            nil

        LastAuraTick[
            controller
        ] =
            0

        return true,
            "REAL KILL AURA ON • "
            .. tostring(
                settings.AuraRadius
            )
            .. " STUDS"
    end

    KillAuraEnabled[
        controller
    ] =
        nil

    KillAuraTarget[
        controller
    ] =
        nil

    LastAuraTick[
        controller
    ] =
        nil

    return true,
        "REAL KILL AURA OFF"
end

local function runKillAura(
    controller
)

    if not KillAuraEnabled[
        controller
    ] then

        return
    end

    local settings =
        settingsFor(
            controller
        )

    if not alive(
        controller
    ) then

        if settings.AutoCombatOffDeath then

            KillAuraEnabled[
                controller
            ] =
                nil

            KillAuraTarget[
                controller
            ] =
                nil

            LastAuraTick[
                controller
            ] =
                nil

            sendResult(
                controller,
                "KillAura",
                false,
                "KILL AURA OFF • RESPAWN"
            )
        end

        return
    end

    if not pvpAllowed(
        controller
    ) then

        if settings.AuraAutoOffPvP then

            KillAuraEnabled[
                controller
            ] =
                nil

            KillAuraTarget[
                controller
            ] =
                nil

            LastAuraTick[
                controller
            ] =
                nil

            sendResult(
                controller,
                "KillAura",
                false,
                "KILL AURA OFF • LEFT PVP"
            )
        end

        return
    end

    local myRoot =
        root(
            controller
        )

    if not myRoot then
        return
    end

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= controller
            and target.Parent ==
                Players
            and alive(
                target
            )
            and not isTrusted(
                controller,
                target
            )
            and target:GetAttribute(
                "VoidHubAuraProtected"
            ) ~= true
            and pvpAllowed(
                target
            ) then

            local targetRoot =
                root(
                    target
                )

            local targetHumanoid =
                humanoid(
                    target
                )

            if targetRoot
                and targetHumanoid
                and targetHumanoid.Health > 0 then

                local distance =
                    (
                        targetRoot.Position
                        - myRoot.Position
                    ).Magnitude

                if distance <=
                    settings.AuraRadius then

                    -- This is server-side damage in the owned game.
                    -- It is not a visual/client-only fake.
                    targetHumanoid:TakeDamage(
                        settings.AuraDamage
                    )
                end
            end
        end
    end
end

local function countTrusted(
    player
)

    return #trustedToArray(
        settingsFor(
            player
