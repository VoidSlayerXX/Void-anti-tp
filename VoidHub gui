function Fortress.rememberSafe(
    controller
)

    local r =
        root(
            controller
        )

    local h =
        humanoid(
            controller
        )

    if not r
        or not h
        or h.Health <= 0
        or h.PlatformStand
        or r.Anchored then

        return
    end

    local dangerY =
        workspace.FallenPartsDestroyHeight
        + Fortress.AntiVoidMargin
        + 35

    if r.Position.Y <=
        dangerY then

        return
    end

    if h.FloorMaterial ==
        Enum.Material.Air then

        return
    end

    local state =
        Fortress.stateFor(
            controller
        )

    -- Do not learn a new "safe" position while an untrusted player has
    -- just entered the anti-exploit zone. This prevents a forced TP to
    -- another floor/location from becoming the new rescue destination.
    if (
        state.ZoneThreatUntil
        or 0
    ) > os.clock() then

        return
    end

    state.SafeCFrame =
        r.CFrame

    state.LastSafeAt =
        os.clock()
end

function Fortress.spawnFallback(
    controller
)

    local myRoot =
        root(
            controller
        )

    local best
    local bestDistance =
        math.huge

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA(
            "SpawnLocation"
        ) then

            local distance =
                myRoot
                and (
                    object.Position
                    - myRoot.Position
                ).Magnitude
                or 0

            if distance <
                bestDistance then

                bestDistance =
                    distance

                best =
                    object
            end
        end
    end

    return best
        and (
            best.CFrame
            *
            CFrame.new(
                0,
                5,
                0
            )
        )
        or nil
end

function Fortress.rescue(
    controller,
    reason
)

    if not controller
        or not alive(
            controller
        ) then

        return false
    end

    local c =
        character(
            controller
        )

    local r =
        root(
            controller
        )

    local h =
        humanoid(
            controller
        )

    if not c
        or not r
        or not h then

        return false
    end

    local state =
        Fortress.stateFor(
            controller
        )

    local now =
        os.clock()

    if now
        - (
            state.LastRescueAt
            or 0
        )
        < 0.25 then

        return false
    end

    state.LastRescueAt =
        now

    local destination =
        state.SafeCFrame
        or AntiGrabGuard.SafeCFrame[
            controller
        ]
        or Fortress.spawnFallback(
            controller
        )

    if not destination then
        return false
    end

    setServerOwnership(
        controller,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        true

    r.Anchored =
        false

    c:PivotTo(
        destination
    )

    zeroVelocity(
        controller
    )

    task.delay(
        0.28,
        function()

            if controller
                and controller.Parent ==
                    Players then

                setServerOwnership(
                    controller,
                    false
                )
            end
        end
    )

    sendResult(
        controller,
        "FortressRescue",
        true,
        "FORTRESS RESCUE • "
        .. tostring(
            reason
            or "SAFE RETURN"
        )
    )

    return true
end

function Fortress.runAntiVoid(
