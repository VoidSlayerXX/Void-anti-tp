local function escapeSafe(reason)

    local now =
        os.clock()

    if now - LastEscapeAt <
        0.75 then

        return false
    end

    if SafeEscaped then

        SafeState.Text =
            "State: ALREADY SAFE • USE RETURN OR RESET"

        return false
    end

    local r =
        root()

    local h =
        humanoid()

    local spawnCF =
        Extra.findNearestSpawnCFrame(
            true
        )

    local cf =
        spawnCF
        or ManualSafeCF
        or AutoSafeCF

    if not r
        or not h then

        SafeState.Text =
            "State: CHARACTER NOT READY"

        return false
    end

    if not cf then

        SafeState.Text =
            "State: NO SPAWN OR SAFE POSITION"

        SafeDash.Text =
            "Safe Escape: NO SPAWN FOUND"

        return false
    end

    LastEscapeAt =
        now

    ReturnCF =
        r.CFrame

    ReturnPositionText.Text =
        "Return Position: EXACT PLACE SAVED"

    stopServerCombatForEscape()

    h.Sit =
        false

    h.PlatformStand =
        false

    if teleportSelf(
        cf
    ) then

        SafeEscaped =
            true

        EscapeReason =
            reason

        SafeState.Text =
            "State: SAFE • RETURN SAVED • "
            .. tostring(
                reason
            )

        SafeDash.Text =
            "Safe Escape: SAFE"

        return true
    end

    SafeState.Text =
        "State: ESCAPE FAILED"

    return false
end

local function returnSafe()

    if not SafeEscaped then

        SafeState.Text =
            "State: NOT CURRENTLY ESCAPED"

        return
    end

    if not ReturnCF then

        SafeState.Text =
