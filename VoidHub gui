                    700 then

                    return 7,
                        "MASSIVE_VERTICAL_700+"
                end

                if absoluteY >=
                    300 then

                    return 5,
                        "CRITICAL_VERTICAL_300+"
                end

                if absoluteY >=
                    100 then

                    return 3,
                        "EXTREME_VERTICAL_100+"
                end

                if absoluteY >=
                    25 then

                    return 1,
                        "VERTICAL_JUMP_25+"
                end

                return 0,
                    nil
            end

            local function classify(
                incident
            )

                local labels = {}

                if (
                    incident.MoveDistance
                    or 0
                ) >=
                    150
                    and (
                        incident.LinearVelocity
                        or 0
                    ) <
                        25 then

                    table.insert(
                        labels,
                        "POSITION_SET_LIKE"
                    )
                end

                if math.abs(
                    incident.YDelta
                    or 0
                ) >=
                    100 then

                    table.insert(
                        labels,
                        (
                            incident.YDelta
                            or 0
                        ) <
                            0
                        and "VERTICAL_DROP"
                        or "VERTICAL_LIFT"
                    )
                end

                if incident.Candidate
                    and (
                        incident.CandidateDistance
                        or 999
                    ) <=
                        5
                    and (
                        incident.DistanceCollapse
                        or 0
                    ) >=
                        20 then

                    table.insert(
                        labels,
                        "BRING_LIKE"
                    )
                end

                if (
                    incident.LinearVelocity
                    or 0
                ) >=
                    140
                    or (
                        incident.AngularVelocity
                        or 0
                    ) >=
                        60 then

                    table.insert(
                        labels,
                        "PHYSICS_FORCE"
                    )
                end

                if (
                    incident.HealthLoss
                    or 0
                ) >=
                    20 then

                    table.insert(
                        labels,
                        "DAMAGE_AFTER_MOVEMENT"
                    )
                end

                if incident.Died then

                    table.insert(
                        labels,
                        "DEATH_AFTER_MOVEMENT"
                    )
                end

                if #labels ==
                    0 then

                    table.insert(
                        labels,
                        "MOVEMENT_ANOMALY"
                    )
                end

                return table.concat(
                    labels,
                    " + "
                )
            end

            local function confidence(
                incident
            )

                local score =
                    incident.SignalScore
                    or 0

                if (
                    incident.HealthLoss
                    or 0
                ) >=
                    70 then

                    score +=
                        6

                elseif (
                    incident.HealthLoss
                    or 0
                ) >=
                    40 then

                    score +=
                        4

                elseif (
                    incident.HealthLoss
                    or 0
                ) >=
                    20 then

                    score +=
                        2
                end

                if incident.Died then

                    score +=
                        7
                end

                if (
                    incident.RepeatCount
                    or 0
                ) >=
                    4 then

                    score +=
                        5

                elseif (
                    incident.RepeatCount
                    or 0
                ) >=
                    3 then

                    score +=
                        4

                elseif (
                    incident.RepeatCount
                    or 0
                ) >=
                    2 then

                    score +=
                        2
                end

                if score >=
                    16 then

                    return "CRITICAL",
                        score
                end

                if score >=
                    10 then

                    return "HIGH",
                        score
                end

                if score >=
                    5 then

                    return "MEDIUM",
                        score
                end

                return "LOW",
                    score
            end

