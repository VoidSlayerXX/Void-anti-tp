--==============================================================
-- SAFE / PROTECTION LOOP
--==============================================================

local protectAcc = 0

RunService.Heartbeat:Connect(function(dt)

    protectAcc +=
        dt

    if protectAcc < 0.1 then
        return
    end

    protectAcc =
        0

    local r =
        root()

    local h =
        humanoid()

    if not r
        or not h then

        return
    end

    local now =
        os.clock()

    local ratio =
        h.Health
        /
        math.max(
            h.MaxHealth,
            1
        )

    if LastHealth
        and h.Health <
            LastHealth - 0.1 then

        LastDamage =
            now
    end

    LastHealth =
        h.Health

    if h.FloorMaterial ~=
        Enum.Material.Air
        and not State.Fly
        and not State.LockBehind then

        LastGroundCF =
            r.CFrame
    end

    local pvp =
        Player:GetAttribute(
            "InPvPZone"
        )

    PvPDetectorText.Text =
        type(pvp) == "boolean"
        and (
            pvp
            and "PvP Detector: INSIDE"
            or "PvP Detector: OUTSIDE"
        )
        or "PvP Detector: AUTO"

    local vel =
        r.AssemblyLinearVelocity

    local horizontal =
        Vector3.new(
            vel.X,
            0,
            vel.Z
        ).Magnitude

    if State.AutoSafe
        and not SafeEscaped
        and not State.Fly
        and not State.LockBehind
        and h.FloorMaterial ~=
            Enum.Material.Air
        and horizontal < 20
        and math.abs(
            vel.Y
        ) < 6
        and ratio >= 0.80
        and now - LastDamage > 5
        and now - LastAutoSafe > 2
        and pvp ~= true then

        LastAutoSafe =
            now

        AutoSafeCF =
            r.CFrame

        refreshSafe()
    end

    if State.LowHP
        and not SafeEscaped
        and activeSafe()
        and ratio <= 0.35 then

        escapeSafe(
            "LOW HP"
        )
    end

    if State.AFK
        and not SafeEscaped
        and activeSafe()
        and now - LastActivity >= 90 then

        escapeSafe(
            "AFK"
        )

        LastActivity =
            now
    end

    if not State.Fly
        and not State.LockBehind then

        if (
            State.AntiVoid
            or State.AutoSafeGround
        )
            and LastGroundCF
            and r.Position.Y <
                workspace.FallenPartsDestroyHeight
                + 20 then

            teleportSelf(
                LastGroundCF
            )
        end

        if State.AntiFling
            and vel.Magnitude >
                State.AntiFlingThreshold then

            zeroVelocity()
        end

        if State.AntiKnockback
            and Vector3.new(
                vel.X,
                0,
                vel.Z
            ).Magnitude > 80 then

            r.AssemblyLinearVelocity =
                Vector3.new(
                    0,
                    vel.Y,
                    0
                )
        end

        if State.AntiLaunch
            and vel.Y > 80 then

            r.AssemblyLinearVelocity =
                Vector3.new(
                    vel.X,
                    8,
                    vel.Z
                )
        end

        if State.AntiSpin then

            r.AssemblyAngularVelocity =
                Vector3.zero
        end

        if State.AntiSit then
            h.Sit =
                false
        end

        if State.AntiFreeze
            and r.Anchored then

            r.Anchored =
                false
        end

        if State.AntiPlatform then

            h.PlatformStand =
                false
        end

        if State.AntiRagdoll then

            local st =
                h:GetState()

            if st ==
                Enum.HumanoidStateType.FallingDown
                or st ==
                    Enum.HumanoidStateType.Physics then

                h.PlatformStand =
                    false

                h:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end
        end

        if State.AntiSpeedReset
            and h.WalkSpeed <
                State.WalkSpeed then

            h.WalkSpeed =
                State.WalkSpeed
        end

        if State.AntiJumpDisable then

            h.UseJumpPower =
                true

            if h.JumpPower <
                State.JumpPower then

                h.JumpPower =
                    State.JumpPower
            end
        end
    end

    if State.AntiTP
        and not State.Fly
        and not State.LockBehind then

        if now <
            AntiTPBypassUntil then

            syncAntiTP()

        elseif not AntiTPLastPosition
            or not AntiTPLastCFrame then

            syncAntiTP()

        else

            local dtime =
                math.max(
                    now - AntiTPLastTime,
                    0.001
                )

            local distance =
                (
                    r.Position
                    - AntiTPLastPosition
                ).Magnitude

            local allowance =
                math.max(
                    50,

                    math.max(
                        math.min(
                            vel.Magnitude,
                            150
                        ),

                        State.WalkSpeed
                    )
                    *
                    dtime
                    *
                    3
                    +
                    15
                )

            if dtime < 0.5
                and distance > allowance then

                r.CFrame =
                    AntiTPLastCFrame

                zeroVelocity()

                ProtectionStatus.Text =
                    "Protection status: ANTI TP BLOCKED"

            else

                syncAntiTP()
            end
        end

    else

        syncAntiTP()
    end
end)

