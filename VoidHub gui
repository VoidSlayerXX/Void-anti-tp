local function voidPrisonLog(
    controller,
    message
)
    if not controller then
        return
    end

    local logs =
        VoidPrison.Logs[
            controller
        ]

    if not logs then
        logs = {}
        VoidPrison.Logs[
            controller
        ] = logs
    end

    table.insert(
        logs,
        1,
        string.format(
            "%.2f • %s",
            os.clock(),
            tostring(
                message
            )
        )
    )

    while #logs > 20 do
        table.remove(
            logs
        )
    end
end

