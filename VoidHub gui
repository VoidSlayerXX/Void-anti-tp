local FlyAttachment
local FlyVelocity
local FlyConnection

local FlyUp = false
local FlyDown = false
local FlyBoosting = false

local FlySmoothedVelocity =
    Vector3.zero

local function destroyFly()

    if FlyConnection then

        FlyConnection:Disconnect()

        FlyConnection =
            nil
    end

    if FlyVelocity then

        FlyVelocity:Destroy()

        FlyVelocity =
            nil
    end

    if FlyAttachment then

        FlyAttachment:Destroy()

        FlyAttachment =
            nil
    end

    FlySmoothedVelocity =
        Vector3.zero
end

local function stopFly()

    State.Fly =
        false

    FlyButton.Text =
        "FLY: OFF"

    destroyFly()

    local h =
        humanoid()

    if h then

        h.PlatformStand =
            false

        h.AutoRotate =
            true
    end

    zeroVelocity()

    FlyStatus.Text =
        "WASD • SPACE • CTRL • LEFTSHIFT BOOST"

    syncAntiTP()
end

local function startFly()

    if State.Fly then
        return
    end

    local r =
        root()

    local h =
        humanoid()

    if not r
        or not h then

        return
    end

    State.LockBehind =
        false

    LockBehindButton.Text =
        "LOCK BEHIND: OFF"

    destroyFly()

    State.Fly =
        true

    FlyButton.Text =
        "FLY: ON"

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        true

    zeroVelocity()

    AntiTPBypassUntil =
        os.clock()
        + 2

    FlyAttachment =
        Instance.new(
            "Attachment"
        )

    FlyAttachment.Name =
        "VoidFlyAttachment"

    FlyAttachment.Parent =
        r

    FlyVelocity =
        Instance.new(
            "LinearVelocity"
        )

    FlyVelocity.Name =
        "VoidFlyVelocity"

    FlyVelocity.Attachment0 =
        FlyAttachment

    FlyVelocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    FlyVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector

    pcall(function()
        FlyVelocity.ForceLimitsEnabled =
            false
    end)

    pcall(function()
        FlyVelocity.MaxForce =
            math.huge
    end)

    FlyVelocity.VectorVelocity =
        Vector3.zero

    FlyVelocity.Parent =
        r

    FlyConnection =
        RunService.RenderStepped:Connect(function(dt)

            if not State.Fly then
                return
            end

            local rr =
                root()

            local hh =
                humanoid()

            if not rr
                or not hh
                or not FlyVelocity then

                stopFly()

                return
            end

            local speed =
                State.FlyHorizontal
                *
                (
                    FlyBoosting
                    and State.FlyBoost
                    or 1
                )

            local move =
                hh.MoveDirection

            local horizontal =
                move.Magnitude > 0.01
                and move.Unit * speed
                or Vector3.zero

            local y =
                0

            if FlyUp
                and not FlyDown then

                y =
                    State.FlyVertical

            elseif FlyDown
                and not FlyUp then

                y =
                    -State.FlyVertical
            end

            local desired =
                Vector3.new(
                    horizontal.X,
                    y,
                    horizontal.Z
                )

            local response =
                desired.Magnitude > 0.01
                and 22
                or 6

            local alpha =
                math.clamp(
                    1
                    - math.exp(
                        -response
                        *
                        math.max(
                            dt,
                            1 / 240
                        )
                    ),
                    0,
                    1
                )

            FlySmoothedVelocity =
                FlySmoothedVelocity:Lerp(
                    desired,
                    alpha
                )

            FlyVelocity.VectorVelocity =
                FlySmoothedVelocity

            hh.PlatformStand =
                false

            hh.AutoRotate =
                true

            AntiTPBypassUntil =
                os.clock()
                + 0.25

            syncAntiTP()

            FlyStatus.Text =
                "FLYING • "
                .. math.floor(
                    speed
                )
                .. " STUDS/S"
                .. (
                    FlyBoosting
                    and " • BOOST"
                    or ""
                )
        end)
end

