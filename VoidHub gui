local function hasGrabVictimEvidence(
    player
)

    if not player then

        return false
    end

    local c =
        character(
            player
        )

    local h =
        humanoid(
            player
        )

    local r =
        root(
            player
        )

    if not c
        or not h
        or not r then

        return false
    end

    -- Strong signal: the game explicitly marks this player as grabbed,
    -- carried, held, kidnapped, restrained, etc.
    for attributeName in pairs(
        GRAB_STATE_NAMES
    ) do

        if player:GetAttribute(
            attributeName
        ) == true
            or c:GetAttribute(
                attributeName
            ) == true then

            return true
        end
    end

    -- Common value-based implementations.
    for _, object in ipairs(
        player:GetDescendants()
    ) do

        if nameLooksLikeGrabVictimState(
            object.Name
        ) then

            if object:IsA(
                "BoolValue"
            )
                and object.Value == true then

                return true

            elseif object:IsA(
                "ObjectValue"
            )
                and object.Value ~= nil then

                return true
            end
        end
    end

    for _, object in ipairs(
        c:GetDescendants()
    ) do

        if nameLooksLikeGrabVictimState(
            object.Name
        ) then

            if object:IsA(
                "BoolValue"
            )
                and object.Value == true then

                return true

            elseif object:IsA(
                "ObjectValue"
            )
                and object.Value ~= nil then

                return true
            end
        end
    end

    -- Immobilization is another strong victim signal.
    if h.PlatformStand
        or r.Anchored then

        return true
    end

    return false
end

local function partInsideCharacter(
