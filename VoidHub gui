--==============================================================
-- V10.11.1 PROTECTED PLAYERS
-- Defensive package only; no admin/offensive permissions.
--==============================================================

local function protectedOwner(target)
    if not target then return nil end

    for controller, settings in pairs(SessionSettings) do
        if controller
            and controller.Parent == Players
            and isAuthorized(controller)
            and type(settings.Protected) == "table"
            and settings.Protected[target.UserId] == true then

            return controller
        end
    end

    return nil
end

local function applyProtected(target)
    if not target or target.Parent ~= Players then return false end

    local owner = protectedOwner(target)

    if not owner then
        target:SetAttribute("VoidHubProtected", false)
        target:SetAttribute("VoidHubProtectedBy", nil)

        local own = settingsFor(target)
        target:SetAttribute("VoidHubAntiBring", own.AntiBring == true)
        target:SetAttribute("VoidHubAntiTrap", own.AntiTrap == true)
        target:SetAttribute("VoidHubAntiGrab", own.AntiGrab == true)
        target:SetAttribute("VoidHubGrabReversal", own.GrabReversal == true)
        target:SetAttribute("VoidHubAntiGymBan", own.AntiGymBan == true)

        GymBanGuard.Enabled[target] =
            own.AntiGymBan == true
            and true
            or nil

        if not isAuthorized(target) then
            Fortress.Enabled[target] = nil
            Fortress.AntiVoid[target] = nil
        end

        return false
    end

    target:SetAttribute("VoidHubProtected", true)
    target:SetAttribute("VoidHubProtectedBy", owner.Name)
    target:SetAttribute("VoidHubAntiBring", true)
    target:SetAttribute("VoidHubAntiTrap", true)
    target:SetAttribute("VoidHubAntiGrab", true)
    target:SetAttribute("VoidHubGrabReversal", true)
    target:SetAttribute("VoidHubAntiGymBan", true)

    GymBanGuard.Enabled[target] = true
    Fortress.Enabled[target] = true
    Fortress.AntiVoid[target] = true

    Fortress.stateFor(target)
    releaseTarget(target)
    clearGrabState(target)
    runAntiGymBan(target)
    Fortress.rememberSafe(target)

    return true
end

local function refreshProtected()
    for _, target in ipairs(Players:GetPlayers()) do
        pcall(applyProtected, target)
    end
end

local function protectedEntries(controller)
    local list = {}
    local settings = settingsFor(controller)

    for userId, enabled in pairs(settings.Protected or {}) do
        if enabled == true then
            local online = Players:GetPlayerByUserId(userId)

            table.insert(list, {
                UserId = userId,
                Name = online and online.Name or tostring(userId),
                DisplayName = online and online.DisplayName or "OFFLINE",
                Online = online ~= nil
            })
        end
    end

    return list
end

local function setProtected(controller, target, enabled)
    if not isAuthorized(controller) then
        return false, "NOT AUTHORIZED"
    end

    if not target or target == controller then
        return false, "INVALID PLAYER"
    end

    local settings = settingsFor(controller)
    settings.Protected = settings.Protected or {}
    settings.Protected[target.UserId] = enabled == true and true or nil

    saveSettings(controller)
    applyProtected(target)

    return true,
        enabled == true
        and ("PROTECTED • " .. target.Name)
        or ("PROTECTION REMOVED • " .. target.Name)
end



