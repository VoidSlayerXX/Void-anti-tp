                if type(
                    incident
                ) ~= "table"
                    or incident.Level ~=
                        "CRITICAL" then

                    return false
                end

                if (
                    tonumber(
                        incident.YDelta
                    )
                    or 0
                ) >
                    -300 then

                    return false
                end

                local class =
                    tostring(
                        incident.Class
                        or ""
                    )

                local positionSet =
                    string.find(
                        class,
                        "POSITION_SET_LIKE",
                        1,
                        true
                    ) ~= nil

                local verticalDrop =
                    string.find(
                        class,
                        "VERTICAL_DROP",
                        1,
                        true
                    ) ~= nil

                return positionSet
                    or verticalDrop
            end

            local function capture(
                incident
            )

                table.insert(
                    panicLog,
                    1,
                    {
                        Id =
                            incident.Id,

                        Time =
                            incident.Time,

                        Level =
                            incident.Level,

                        Class =
                            incident.Class,

                        MoveDistance =
                            incident.MoveDistance,

                        DeltaTime =
                            incident.DeltaTime,

                        TeleportSpeed =
                            incident.TeleportSpeed,

                        YDelta =
                            incident.YDelta,

                        LinearVelocity =
                            incident.LinearVelocity,

                        AngularVelocity =
                            incident.AngularVelocity,

                        HealthBefore =
                            incident.HealthBefore,

                        HealthAfter =
                            incident.HealthAfter,

                        UITriggerMatched =
                            incident.UITriggerMatched,

                        UITriggerDelay =
                            incident.UITriggerDelay,

                        WatchTargetCorrelated =
                            incident.WatchTargetCorrelated
                    }
                )

                while #panicLog >
                    20 do

                    table.remove(
                        panicLog
                    )
                end

                render()
            end

            autoButton.Activated:Connect(function()

                autoEscape =
                    not autoEscape

                autoButton.Text =
                    autoEscape
                    and "AUTO ESCAPE: ON"
                    or "AUTO ESCAPE: OFF"

                status.Text =
                    autoEscape
                    and "Status: ARMED • Auto Escape ON"
                    or "Status: ARMED • Auto Escape OFF"

                render()
            end)

            rejoinButton.Activated:Connect(function()

                normalRejoin(
                    "manual"
                )
            end)

            clearButton.Activated:Connect(function()

                panicLog =
                    {}

                qualifyingTimes =
                    {}

                lastIncidentId =
                    nil

                status.Text =
                    "Status: ARMED • panic log cleared"

                render()
            end)

            RunService.Heartbeat:Connect(function()

                if not armed
                    or escapeInProgress then

                    return
                end

                local incident =
                    _G.VoidHubLastMaxIncident

                if type(
                    incident
                ) ~= "table"
                    or not incident.Id
                    or incident.Id ==
                        lastIncidentId then

                    return
                end

                lastIncidentId =
                    incident.Id

                if not qualifies(
                    incident
                ) then

                    return
                end

                local now =
                    os.clock()

                prune(
                    now
                )

                table.insert(
                    qualifyingTimes,
                    now
                )

                capture(
                    incident
                )

                status.Text =
                    "Status: CRITICAL VOID "
                    .. tostring(
                        #qualifyingTimes
                    )
                    .. "/2 IN 5s"

                pcall(function()

                    StarterGui:SetCore(
                        "SendNotification",
                        {
                            Title =
                                "VOID HUB • CRITICAL VOID",

                            Text =
                                tostring(
                                    #qualifyingTimes
                                )
                                .. "/2 panic triggers within 5 seconds.",

                            Duration =
                                4
                        }
                    )
                end)

                if autoEscape
                    and #qualifyingTimes >=
                        2 then

                    normalRejoin(
                        "2 critical void drops in 5s"
                    )

                    return
                end

                local clanEscalation =
                    _G.VoidHubClanPanicEscalation

                if autoEscape
                    and type(clanEscalation) == "table"
                    and type(clanEscalation.Time) == "number"
                    and os.clock() - clanEscalation.Time <= 3.0 then

                    _G.VoidHubClanPanicEscalation = nil

                    normalRejoin(
                        "clan defense escalation • "
                        .. tostring(
                            clanEscalation.Reason
                            or "repeated critical OG correlation"
                        )
                    )
                end
            end)

            render()
        end)

    if not ok then

        warn(
            "VOID HUB PANIC PROTECTION ERROR: "
            .. tostring(
                err
            )
        )
    end
end



--==============================================================
-- V10.21 CLAN WAR DEFENSE
-- Friendly clans: RNG / AGD / FOE
-- Watched clan: OG
-- Defensive awareness only. No attacks or retaliation.
--==============================================================

local function __installClanWarDefense()

    local ok, err = pcall(function()

        local B = _G.VoidHubAddonBridge

        if type(B) ~= "table"
            or not B.Gui
            or not B.Gui.Parent
            or not B.Sidebar
            or not B.Content
            or not B.Pages
            or not B.Tabs
            or not B.ShowPage
            or not B.Button
            or not B.Label
            or not B.Heading
            or not B.Corner
            or not B.Stroke
            or not B.Players
            or not B.Player then

            error("stable panel bridge is not ready")
        end

        if B.Pages.CLANWAR then
            return
        end

        local Players = B.Players
        local LocalPlayer = B.Player
        local RunService = game:GetService("RunService")
        local StarterGui = game:GetService("StarterGui")

        B.Sidebar.CanvasSize = UDim2.fromOffset(0, 1050)

        local tab = B.Button(
            B.Sidebar,
            "CLAN WAR DEFENSE",
            15,
            16 + (20 - 1) * 50,
            160,
            42
        )

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.CanvasSize = UDim2.fromOffset(0, 980)
        page.Visible = false
        page.Parent = B.Content

        B.Tabs.CLANWAR = tab
        B.Pages.CLANWAR = page

        tab.Activated:Connect(function()
            B.ShowPage("CLANWAR")
        end)

        B.Heading(page, "CLAN WAR DEFENSE • RNG / AGD / FOE vs OG")

        local status = B.Label(
            page,
            "Status: ON • OG watched • RNG / AGD / FOE friendly",
            0, 46, 700, 30, 10
        )
        status.Font = Enum.Font.GothamBold

        local toggleButton = B.Button(page, "CLAN WATCH: ON", 0, 92, 225, 42)
        local scanButton = B.Button(page, "SCAN PLAYERS NOW", 245, 92, 225, 42)
        local clearButton = B.Button(page, "CLEAR CLAN LOG", 490, 92, 225, 42)

        local info = B.Label(
            page,
            "Friendly tags: RNG, AGD, FOE. Watched tag: OG. OG-tagged players are correlated with MAX DEFENSE X incidents and proximity. Friendly-tagged players are excluded from threat correlation. Presence is context only and does not prove who caused an incident.",
            0, 150, 700, 95, 9
        )
        info.TextWrapped = true

        local report = Instance.new("TextBox")
        report.Size = UDim2.fromOffset(720, 675)
        report.Position = UDim2.fromOffset(0, 270)
        report.BackgroundColor3 = Color3.fromRGB(25, 30, 51)
        report.BorderSizePixel = 0
        report.TextColor3 = Color3.fromRGB(245, 247, 255)
        report.Font = Enum.Font.Code
        report.TextSize = 12
        report.TextXAlignment = Enum.TextXAlignment.Left
        report.TextYAlignment = Enum.TextYAlignment.Top
        report.ClearTextOnFocus = false
        report.MultiLine = true
        report.Text = "CLAN WAR DEFENSE\n==============================\nScanning..."
        report.Parent = page

        B.Corner(report, 10)
        B.Stroke(report, 0.38, 1, Color3.fromRGB(89, 101, 164))

        local enabled = true
        local accumulator = 0
        local lastIncidentId = nil
        local lastAlertAt = 0
        local logs = {}
        local ogHistory = {}
        local liveFriendly = {}
        local liveOG = {}
        local totalOGIncidents = 0
        local totalOGCritical = 0

        local function upper(value)
            return string.upper(tostring(value or ""))
        end

        local function tokenList(value)
            local out = {}
            for token in string.gmatch(upper(value), "[A-Z0-9]+") do
                table.insert(out, token)
            end
            return out
        end

        local function hasTag(value, tag)
            local wanted = upper(tag)
            local raw = upper(value)

            for _, token in ipairs(tokenList(raw)) do
                if token == wanted then
                    return true
                end

                if wanted == "OG" then
                    if token == "OGX" then
                        return true
                    end
                    if string.sub(token, 1, 2) == "OG" and #token <= 5 then
                        return true
                    end
                end
            end

            if wanted == "OG" then
                if string.find(raw, "THE-OG", 1, true)
                    or string.find(raw, "[OG]", 1, true) then
                    return true
                end
            end

            return false
        end

        local function clanFor(player)
            if not player then
                return nil
            end

            for _, value in ipairs({player.Name, player.DisplayName}) do
                if hasTag(value, "RNG") then
                    return "RNG", "FRIENDLY"
                end
                if hasTag(value, "AGD") then
                    return "AGD", "FRIENDLY"
                end
                if hasTag(value, "FOE") then
                    return "FOE", "FRIENDLY"
                end
                if hasTag(value, "OG") then
                    return "OG", "WATCHED"
                end
            end

            return nil
        end

        local function rootOf(player)
            local c = player and player.Character
            return c and c:FindFirstChild("HumanoidRootPart")
        end

        local function rebuildLive()
            liveFriendly = {}
            liveOG = {}

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local clan, relation = clanFor(player)

                    if relation == "FRIENDLY" then
                        table.insert(liveFriendly, {Player = player, Clan = clan})
                    elseif relation == "WATCHED" then
                        table.insert(liveOG, {Player = player, Clan = clan})
                    end
                end
            end
        end

        local function nearestOG()
            local selfRoot = rootOf(LocalPlayer)
            if not selfRoot then
                return nil, math.huge
            end

            local bestPlayer = nil
            local bestDistance = math.huge

            for _, row in ipairs(liveOG) do
                local r = rootOf(row.Player)
                if r then
                    local d = (selfRoot.Position - r.Position).Magnitude
                    if d < bestDistance then
                        bestPlayer = row.Player
                        bestDistance = d
                    end
                end
            end

            return bestPlayer, bestDistance
        end

        local function nearbyOGFromIncident(incident)
            local matches = {}

            if type(incident) ~= "table"
                or type(incident.Nearby) ~= "table" then
                return matches
            end

            for _, near in ipairs(incident.Nearby) do
                local player = near.UserId
                    and Players:GetPlayerByUserId(near.UserId)
                    or nil

                local _, relation = clanFor(player)

                if relation == "WATCHED" then
                    table.insert(matches, {
                        Name = player.Name,
                        UserId = player.UserId,
                        Distance = near.Distance or math.huge
                    })
                end
            end

            table.sort(matches, function(a, b)
                return a.Distance < b.Distance
            end)

            return matches
        end

        local function addLog(message)
            table.insert(
                logs,
                1,
                string.format("%.2f • %s", os.clock(), tostring(message))
            )
            while #logs > 40 do
                table.remove(logs)
            end
        end

        local function render()
            local nearest, nearestDistance = nearestOG()

            local lines = {
                "VOID HUB CLAN WAR DEFENSE",
                "==============================",
                enabled and "Watcher: ON" or "Watcher: OFF",
                "Friendly: RNG • AGD • FOE",
                "Watched: OG",
                "",
                "LIVE:",
                "  Friendly-tagged online: " .. tostring(#liveFriendly),
                "  OG-tagged online: " .. tostring(#liveOG),
                "  Nearest OG: "
                    .. (
                        nearest
                        and ("@" .. nearest.Name .. " • " .. string.format("%.1f studs", nearestDistance))
                        or "none"
                    ),
                "",
                "INCIDENT COUNTERS:",
                "  OG-correlated MAX incidents: " .. tostring(totalOGIncidents),
                "  OG-correlated CRITICAL incidents: " .. tostring(totalOGCritical),
                "",
                "PER-OG HISTORY:"
            }

            local names = {}
            for name in pairs(ogHistory) do
                table.insert(names, name)
            end
            table.sort(names)

            if #names == 0 then
                table.insert(lines, "  none yet")
            else
                for _, name in ipairs(names) do
                    local row = ogHistory[name]
                    table.insert(
                        lines,
                        "  @" .. name
                        .. " • incidents " .. tostring(row.Incidents)
                        .. " • critical " .. tostring(row.Critical)
                        .. " • closest " .. string.format("%.1f", row.Closest)
                    )
                end
            end

            table.insert(lines, "")
            table.insert(lines, "RECENT LOG:")

            if #logs == 0 then
                table.insert(lines, "  none")
            else
                for _, line in ipairs(logs) do
                    table.insert(lines, "  " .. line)
                end
            end

            table.insert(lines, "")
            table.insert(
                lines,
                "OG presence is correlation context only; source remains unproven."
            )

            report.Text = table.concat(lines, "\n")
        end

        local function alert(message)
            local now = os.clock()
            if now - lastAlertAt < 2.0 then
                return
            end

            lastAlertAt = now

            pcall(function()
                StarterGui:SetCore(
                    "SendNotification",
                    {
                        Title = "VOID HUB • CLAN DEFENSE",
                        Text = message,
                        Duration = 5
                    }
                )
            end)
        end

        local function processIncident(incident)
            if type(incident) ~= "table"
                or not incident.Id
                or incident.Id == lastIncidentId then
                return
            end

            lastIncidentId = incident.Id

            local ogNearby = nearbyOGFromIncident(incident)
            if #ogNearby == 0 then
                return
            end

            totalOGIncidents += 1

            if incident.Level == "CRITICAL" then
                totalOGCritical += 1
            end

            local now = os.clock()

            for _, row in ipairs(ogNearby) do
                local history = ogHistory[row.Name]

                if not history then
                    history = {
                        Incidents = 0,
                        Critical = 0,
                        Closest = math.huge,
                        CriticalTimes = {}
                    }
                    ogHistory[row.Name] = history
                end

                history.Incidents += 1
                history.Closest = math.min(history.Closest, row.Distance)

                if incident.Level == "CRITICAL" then
                    history.Critical += 1
                    table.insert(history.CriticalTimes, now)

                    while #history.CriticalTimes > 20 do
                        table.remove(history.CriticalTimes, 1)
                    end
                end
            end

            local nearest = ogNearby[1]

            addLog(
                tostring(incident.Level or "UNKNOWN")
                .. " MAX incident with OG context @"
                .. nearest.Name
                .. " • "
                .. string.format("%.1f studs", nearest.Distance)
            )

            if incident.Level == "CRITICAL" then
                alert(
                    "CRITICAL movement event with OG-tagged player nearby. Source not proven."
                )

                local recentCritical = 0

                for _, row in ipairs(ogNearby) do
                    local history = ogHistory[row.Name]
                    if history then
                        for i = #history.CriticalTimes, 1, -1 do
                            if now - history.CriticalTimes[i] <= 8.0 then
                                recentCritical += 1
                            else
                                break
                            end
                        end
                    end
                end

                if recentCritical >= 2 then
                    _G.VoidHubClanPanicEscalation = {
                        Time = now,
                        IncidentId = incident.Id,
                        Reason = "Repeated CRITICAL MAX events with OG proximity",
                        OG = nearest.Name
                    }

                    addLog(
                        "PANIC ESCALATION armed • repeated CRITICAL + OG proximity"
                    )
                end
            end

            render()
        end

        toggleButton.Activated:Connect(function()
            enabled = not enabled
            toggleButton.Text = enabled and "CLAN WATCH: ON" or "CLAN WATCH: OFF"
            status.Text = enabled
                and "Status: ON • OG watched • allies friendly"
                or "Status: OFF"
            render()
        end)

        scanButton.Activated:Connect(function()
            rebuildLive()
            status.Text = "Status: PLAYER SCAN COMPLETE"
            render()
        end)

        clearButton.Activated:Connect(function()
            logs = {}
            ogHistory = {}
            totalOGIncidents = 0
            totalOGCritical = 0
            lastIncidentId = nil
            _G.VoidHubClanPanicEscalation = nil
            status.Text = enabled
                and "Status: ON • clan log cleared"
                or "Status: OFF • clan log cleared"
            render()
        end)

        RunService.Heartbeat:Connect(function(dt)
            if not enabled then
                return
            end

            accumulator += dt
            if accumulator < 0.50 then
                return
            end

            accumulator = 0

            rebuildLive()
            processIncident(_G.VoidHubLastMaxIncident)
            render()
        end)

        Players.PlayerAdded:Connect(function()
            task.delay(0.5, function()
                if enabled then
                    rebuildLive()
                    render()
                end
            end)
        end)

        Players.PlayerRemoving:Connect(function()
            task.delay(0.2, function()
                if enabled then
                    rebuildLive()
                    render()
                end
            end)
        end)

        rebuildLive()
        render()
    end)

    if not ok then
        warn("VOID HUB CLAN WAR DEFENSE ERROR: " .. tostring(err))
    end
end


