                )
            )

        return
    end

    PvPStatus.Text =
        "STATUS • "
        .. tostring(
            message
            or action
        )

    if not ok
        and action ==
            "Trap" then

        TrapActive =
            false

        TrapButton.Text =
            "TRAP VOID: OFF"
    end

    if action ==
        "KillAura" then

