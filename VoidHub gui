local function cloneTrusted(source)

    local trusted = {}

    if type(source) ~=
        "table" then

        return trusted
    end

    for key, value in pairs(
        source
    ) do

        if type(key) ==
            "number"
            and type(value) ==
                "number" then

            trusted[
                math.floor(
                    value
                )
            ] =
                true

        elseif tonumber(key)
            and value == true then

            trusted[
                math.floor(
                    tonumber(
                        key
                    )
                )
            ] =
                true
        end
    end

    return trusted
end

local function trustedToArray(trusted)

    local list = {}

    for userId, enabled in pairs(
        trusted
    ) do

        if enabled == true
            and type(userId) ==
                "number" then

            table.insert(
                list,
                userId
            )
        end
    end

    table.sort(
        list
    )

    return list
end

