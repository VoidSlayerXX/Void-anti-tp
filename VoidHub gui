        targetPlayer,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        false

    r.Anchored =
        true

    local destroyY =
        workspace.FallenPartsDestroyHeight
        - 30

    c:PivotTo(
        CFrame.new(
