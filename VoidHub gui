function Extra.setKillAuraEnabled(enabled)

    enabled =
        enabled == true

    if enabled then

        if not SelectedPlayer
            or SelectedPlayer == Player
            or SelectedPlayer.Parent ~= Players then

            State.KillAura =
                false

            Extra.PendingKillAura =
                nil

            PvPStatus.Text =
                "STATUS • SELECT PLAYER FIRST"

            toggleText(
                KillAuraButton,
                "KILL AURA",
                false
            )

            return false
        end

        local targetHumanoid =
            SelectedPlayer.Character
            and SelectedPlayer.Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not targetHumanoid
            or targetHumanoid.Health <= 0 then

            State.KillAura =
                false

            Extra.PendingKillAura =
                nil

            PvPStatus.Text =
                "STATUS • TARGET NOT READY"

            toggleText(
                KillAuraButton,
                "KILL AURA",
                false
            )

            return false
        end

        Extra.sendAuraConfig()
    end

    Extra.PendingKillAura =
        enabled

    local sent =
        sendServerAction(
            "KillAura",
            SelectedPlayer,
            enabled
        )

    if not sent then

        Extra.PendingKillAura =
            nil

        State.KillAura =
            false

        PvPStatus.Text =
            "STATUS • ACTION UNAVAILABLE"

        toggleText(
            KillAuraButton,
            "KILL AURA",
            false
        )

        return false
    end

    PvPStatus.Text =
        enabled
        and (
            "STATUS • AURA REQUEST • "
            .. SelectedPlayer.Name
        )
        or "STATUS • AURA OFF REQUEST"

    return true
end

