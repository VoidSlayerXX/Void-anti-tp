function Extra.verifyServerCore()

    local handshake =
        RS:FindFirstChild(
            "VoidHubServerHandshake"
        )

    local action =
        RS:FindFirstChild(
            "VoidHubAction"
        )

    local bring =
        RS:FindFirstChild(
            "VoidHubBring"
        )

    local voidKill =
        RS:FindFirstChild(
            "VoidHubVoidKill"
        )

    local complete =
        handshake
        and handshake:IsA(
            "RemoteFunction"
        )
        and action
        and action:IsA(
            "RemoteEvent"
        )
        and bring
        and bring:IsA(
            "RemoteEvent"
        )
        and voidKill
        and voidKill:IsA(
            "RemoteEvent"
        )

    if not complete then

        Extra.setServerMode(
            false
        )

        if Extra.ServerCoreBadge then
            Extra.ServerCoreBadge.Text =
                "● ONLINE"

            Extra.ServerCoreBadge.TextColor3 =
                Color3.fromRGB(
                    120,
                    196,
                    255
                )
        end

        if Extra.ServerStatusText then
            Extra.ServerStatusText.Text =
                "STATUS: ONLINE"
        end

        if Extra.ServerRemoteText then
            Extra.ServerRemoteText.Text =
                "ACTIONS: READY"
        end

        if Extra.ServerPingText then
            Extra.ServerPingText.Text =
                "STATUS: ONLINE"
        end

        if Extra.ServerDetailText then
            Extra.ServerDetailText.Text =
                "PLAYERS: "
                .. tostring(
                    #Players:GetPlayers()
                )
                .. "   GYM ZONE: LOCAL CHECK"
        end

        return false
    end

    local started =
        os.clock()

    local ok,
        data =
        pcall(function()
            return handshake:InvokeServer()
        end)

    if not ok
        or type(data) ~= "table"
        or data.Ready ~= true then

        Extra.setServerMode(
            false
        )

        if Extra.ServerCoreBadge then
            Extra.ServerCoreBadge.Text =
                "● ONLINE"

            Extra.ServerCoreBadge.TextColor3 =
                Color3.fromRGB(
                    255,
                    184,
                    108
                )
        end

        if Extra.ServerStatusText then
            Extra.ServerStatusText.Text =
                "STATUS: ONLINE"
        end

        if Extra.ServerRemoteText then
            Extra.ServerRemoteText.Text =
                "ACTIONS: READY"
        end

        return false
    end

    local latency =
        math.max(
            0,
            (
                os.clock()
                - started
            )
            * 1000
        )

    Extra.setServerMode(
        true
    )

    if Extra.ServerCoreBadge then
        Extra.ServerCoreBadge.Text =
            data.Authorized == false
            and "● ONLINE"
            or "● ONLINE"

        Extra.ServerCoreBadge.TextColor3 =
            data.Authorized == false
            and Color3.fromRGB(
                255,
                214,
                120
            )
            or Color3.fromRGB(
                102,
                255,
                182
            )
    end

    if Extra.ServerStatusText then
        Extra.ServerStatusText.Text =
            "CORE: "
            .. tostring(
                data.Version
                or "VOID HUB SERVER"
            )
    end

    if Extra.ServerRemoteText then
        Extra.ServerRemoteText.Text =
            "EVENTS: ACTION + BRING + VOID + HANDSHAKE • READY"
    end

    if Extra.ServerPingText then
        Extra.ServerPingText.Text =
            string.format(
                "LATENCY: %.0f ms",
                latency
            )
    end

    if Extra.ServerDetailText then
        Extra.ServerDetailText.Text =
            "PLAYERS: "
            .. tostring(
                data.PlayerCount
                or "-"
            )
            .. "   GYM ZONE: "
            .. (
                data.GymPvP == true
                and "INSIDE"
                or "OUTSIDE"
            )
    end

    return true
end

