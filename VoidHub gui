        function()

            if targetPlayer
                and targetPlayer.Parent ==
                    Players then

                setServerOwnership(
                    targetPlayer,
                    false
                )
            end
        end
    )

    return true
end

local function voidAllPlayers(
    controller
)

    if not controller
        or not isAuthorized(
            controller
        ) then

        return false,
            "NOT AUTHORIZED"
    end

    local moved =
        0

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= controller
            and alive(
                target
            )
            and not isTrusted(
                controller,
                target
            ) then

            local ok =
                voidKillPlayer(
                    target
                )

            if ok then

                moved +=
                    1
            end
        end
    end

    return moved > 0,
        moved > 0
            and (
                "VOID ALL • "
                .. tostring(
                    moved
                )
                .. " PLAYER"
                .. (
                    moved == 1
                    and ""
                    or "S"
                )
            )
            or "NO ELIGIBLE PLAYERS"
end

