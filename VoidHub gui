local function runDefenseTest(
    controller,
    target,
    mode
)
    local allowed,
        denyMessage =
        defenseTestTargetAllowed(
            controller,
            target
        )

    if not allowed then

        return false,
            denyMessage
    end

    local targetRoot =
        root(
            target
        )

    local targetHumanoid =
        humanoid(
            target
        )

    local voidCF =
        defenseTestVoidCFrame(
            target
        )

    if not targetRoot
        or not targetHumanoid
        or not voidCF then

        return false,
            "TEST TARGET NOT READY"
    end

    DefenseTest.ReturnCFrame[
        target
    ] =
        targetRoot.CFrame

    local token =
        (
            DefenseTest.Token[
                target
            ]
            or 0
        )
        + 1

    DefenseTest.Token[
        target
    ] =
        token

    local beforeHealth =
        targetHumanoid.Health

    if not movePlayerServer(
        target,
        voidCF
    ) then

        DefenseTest.ReturnCFrame[
            target
        ] =
            nil

        DefenseTest.Token[
            target
        ] =
            nil

        return false,
            "FORCED VOID TP TEST FAILED"
    end

    if mode ==
        "DAMAGE50" then

        task.delay(
            0.10,
            function()

                if DefenseTest.Token[
                    target
                ] ~= token then
                    return
                end

                local h =
                    humanoid(
                        target
                    )

                if h
                    and h.Health > 0 then

                    h:TakeDamage(
                        50
                    )
                end
            end
        )

    elseif mode ==
        "LETHAL" then

        task.delay(
            0.10,
            function()

                if DefenseTest.Token[
                    target
                ] ~= token then
                    return
                end

                local h =
                    humanoid(
                        target
                    )

                if h
                    and h.Health > 0 then

                    h.Health =
                        0
                end
            end
        )
    end

    if mode ==
        "LETHAL" then

        task.delay(
            0.40,
            function()

                if DefenseTest.Token[
                    target
                ] ~= token then
                    return
                end

                DefenseTest.ReturnCFrame[
                    target
                ] =
                    nil

                DefenseTest.Token[
                    target
                ] =
                    nil
            end
        )

        return true,
            "LETHAL TEST FIRED • VOID TP + 1-TAP • "
            .. target.Name
    end

    task.delay(
        DefenseTest.AutoReturnDelay,
        function()

            if DefenseTest.Token[
                target
            ] ~= token then
                return
            end

            local currentRoot =
                root(
                    target
                )

            local currentHumanoid =
                humanoid(
                    target
                )

            local defenseReacted =
                false

            if currentRoot then

                defenseReacted =
                    currentRoot.Position.Y
                    >
                    workspace.FallenPartsDestroyHeight
                    + 45
            end

            local afterHealth =
                currentHumanoid
                and currentHumanoid.Health
                or 0

            local returnCF =
                DefenseTest.ReturnCFrame[
                    target
                ]

            if returnCF
                and alive(
                    target
                )
                and not defenseReacted then

                movePlayerServer(
                    target,
                    returnCF
                )
            end

            DefenseTest.ReturnCFrame[
                target
            ] =
                nil

            DefenseTest.Token[
                target
            ] =
                nil

            local modeLabel =
                mode == "DAMAGE50"
                and "VOID + 50 DAMAGE"
                or "VOID TP"

            local result =
                defenseReacted
                and (
                    "DEFENSE REACTED • "
                    .. modeLabel
                    .. " • "
                    .. target.Name
                )
                or (
                    "FALLBACK RETURNED • "
                    .. modeLabel
                    .. " • HP "
                    .. tostring(
                        math.floor(
                            beforeHealth
                        )
                    )
                    .. "→"
                    .. tostring(
                        math.floor(
                            afterHealth
                        )
                    )
                )

            DefenseTest.LastResult[
                controller
            ] =
                result

            sendResult(
                controller,
                "DefenseTestResult",
                defenseReacted,
                result
            )
        end
    )

    return true,
        mode == "DAMAGE50"
        and (
            "TEST STARTED • VOID TP + 50 DAMAGE • "
            .. target.Name
        )
        or (
            "TEST STARTED • FORCED VOID TP • "
            .. target.Name
        )
end


local function nameLooksLikeGrab(name)

    local lower =
