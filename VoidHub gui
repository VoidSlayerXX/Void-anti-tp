local function updateScale()
    local camera = workspace.CurrentCamera
    local v = camera and camera.ViewportSize or Vector2.new(1280, 720)

    local baseScale =
        math.clamp(
            math.min(
                v.X / 1000,
                v.Y / 700
            ),
            0.55,
            1
        )

    ResponsiveScale.Scale =
        math.clamp(
            baseScale
                * (
                    Extra.UserScale
                    or 1
                ),
            0.45,
            1.35
        )
end

