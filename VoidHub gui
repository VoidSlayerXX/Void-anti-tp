Extra.applyServerSettings = function(data)

    if type(data) ~=
        "table" then

        return
    end

    if tonumber(
        data.AuraRadius
    ) then

        State.AuraRadius =
            math.clamp(
                tonumber(
                    data.AuraRadius
                ),
                5,
                50
            )
    end

    if tonumber(
        data.AuraDamage
    ) then

        State.AuraDamage =
            math.clamp(
                tonumber(
                    data.AuraDamage
                ),
                5,
                100
            )
    end

    if tonumber(
        data.AuraTick
    ) then

        State.AuraTick =
            math.clamp(
                tonumber(
                    data.AuraTick
                ),
                0.05,
                1
            )
    end

    if type(
        data.AuraHoldKey
    ) == "boolean" then

        State.AuraHoldKey =
