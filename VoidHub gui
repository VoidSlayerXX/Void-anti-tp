function Extra.makeSlider(
    parent,
    title,
    minValue,
    maxValue,
    initialValue,
    step,
    x,
    y,
    width,
    formatter,
    onChanged
)

    local holder =
        Instance.new(
            "Frame"
        )

    holder.Size =
        UDim2.fromOffset(
            width,
            52
        )

    holder.Position =
        UDim2.fromOffset(
            x,
            y
        )

    holder.BackgroundTransparency =
        1

    holder.Parent =
        parent

    local titleLabel =
        label(
            holder,
            title,
            0,
            0,
            width - 90,
            18,
            9
        )

    titleLabel.Font =
        Enum.Font.GothamSemibold

    local valueLabel =
        label(
            holder,
            "",
            width - 85,
            0,
            85,
            18,
            9
        )

    valueLabel.TextXAlignment =
        Enum.TextXAlignment.Right

    local track =
        Instance.new(
            "Frame"
        )

    track.Size =
        UDim2.new(
            1,
            0,
            0,
            8
        )

    track.Position =
        UDim2.fromOffset(
            0,
            31
        )

    track.BackgroundColor3 =
        Color3.fromRGB(
            47,
            59,
            108
        )

    track.BorderSizePixel =
        0

    track.Active =
        true

    track.Parent =
        holder

    corner(
        track,
        8
    )

    local fill =
        Instance.new(
            "Frame"
        )

    fill.Size =
        UDim2.fromScale(
            0,
            1
        )

    fill.BackgroundColor3 =
        Color3.fromRGB(
            143,
            122,
            255
        )

    fill.BorderSizePixel =
        0

    fill.Parent =
        track

    corner(
        fill,
        8
    )

    local knob =
        Instance.new(
            "Frame"
        )

    knob.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    knob.Size =
        UDim2.fromOffset(
            18,
            18
        )

    knob.Position =
        UDim2.fromScale(
            0,
            0.5
        )

    knob.BackgroundColor3 =
        Color3.fromRGB(
            235,
            240,
            255
        )

    knob.BorderSizePixel =
        0

    knob.Active =
        true

    knob.Parent =
        track

    corner(
        knob,
        20
    )

    stroke(
        knob,
        0.18,
        1,
        Color3.fromRGB(
            120,
            130,
            255
        )
    )

    local current =
        initialValue

    local draggingSlider =
        false

    local function normalize(value)

        local stepped =
            math.floor(
                (value / step) + 0.5
            )
            * step

        return math.clamp(
            stepped,
            minValue,
            maxValue
        )
    end

    local function render()

        local alpha =
            (
                current
                - minValue
            )
            /
            math.max(
                maxValue
                - minValue,
                0.0001
            )

        alpha =
            math.clamp(
                alpha,
                0,
                1
            )

        fill.Size =
            UDim2.fromScale(
                alpha,
                1
            )

        knob.Position =
            UDim2.fromScale(
                alpha,
                0.5
            )

        valueLabel.Text =
            formatter
            and formatter(
                current
            )
            or tostring(
                current
            )
    end

    local function setValue(
        value,
        fireChanged
    )

        current =
            normalize(
                tonumber(value)
                or current
            )

        render()

        if fireChanged ~= false
            and onChanged then

            onChanged(
                current
            )
        end
    end

    local function updateFromX(xPosition)

        local left =
            track.AbsolutePosition.X

        local widthNow =
            math.max(
                track.AbsoluteSize.X,
                1
            )

        local alpha =
            math.clamp(
                (
                    xPosition
                    - left
                )
                / widthNow,
                0,
                1
            )

        setValue(
            minValue
            + (
                maxValue
                - minValue
            )
            * alpha,
            true
        )
    end

    local function beginDrag(input)

        draggingSlider =
            true

        updateFromX(
            input.Position.X
        )
    end

    track.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            beginDrag(
                input
            )
        end
    end)

    knob.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            beginDrag(
                input
            )
        end
    end)

    UIS.InputChanged:Connect(function(input)

        if not draggingSlider then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            updateFromX(
                input.Position.X
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
                Enum.UserInputType.Touch then

            draggingSlider =
                false
        end
    end)

    setValue(
        initialValue,
        false
    )

    return {
        SetValue =
            function(value)

                setValue(
                    value,
                    false
                )
            end,

        GetValue =
            function()

                return current
            end
    }
end

