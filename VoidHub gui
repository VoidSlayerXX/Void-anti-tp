function Extra.onServerResult(
    kind,
    action,
    ok,
    message
)

    if kind ~= "ActionResult"
        and kind ~= "RESULT" then

        return
    end

    if action ==
        "Status" then

        if ok
            and type(message) ==
                "table" then

            local ping

            if tonumber(
                message.ClientStamp
            ) then

                ping =
                    math.max(
                        0,
                        (
                            os.clock()
                            - message.ClientStamp
                        )
                        * 1000
                    )
            end

            if Extra.ServerStatusText then

                Extra.ServerStatusText.Text =
                    message.Authorized == false
                    and "CORE: CONNECTED • NOT AUTHORIZED"
                    or (
                        "CORE: CONNECTED • "
                        .. tostring(
                            message.Version
                            or "VOID HUB"
                        )
                    )
            end

            if Extra.ServerRemoteText then

                Extra.ServerRemoteText.Text =
                    "EVENTS: ACTION + BRING + VOID + HANDSHAKE • READY"
            end

            if Extra.ServerPingText then

                Extra.ServerPingText.Text =
                    ping
                    and string.format(
                        "LATENCY: %.0f ms",
                        ping
                    )
                    or "LATENCY: READY"
            end

            if Extra.ServerDetailText then

                Extra.ServerDetailText.Text =
                    "PLAYERS: "
                    .. tostring(
                        message.PlayerCount
                        or "-"
                    )
                    .. "   GYM ZONE: "
                    .. (
                        message.PvP == true
                        and "INSIDE"
                        or "OUTSIDE"
                    )
            end

            if Extra.AntiBringBadge then

                Extra.AntiBringBadge.Text =
                    "ANTI BRING: "
                    .. (
                        message.AntiBring
                        and "ON"
                        or "OFF"
                    )
            end

            if Extra.AntiTrapBadge then

                Extra.AntiTrapBadge.Text =
                    "ANTI TRAP: "
                    .. (
                        message.AntiTrap
                        and "ON"
                        or "OFF"
                    )
            end
        end

        return
    end

    if action ==
        "Settings"
        and ok
        and type(message) ==
            "table" then

        if Extra.applyServerSettings then

            Extra.applyServerSettings(
                message
            )
        end

        return
    end

    if action ==
        "SetTrusted" then

        if Extra.TrustedStatus then

            Extra.TrustedStatus.Text =
                tostring(
                    message
                    or "TRUSTED LIST UPDATED"
                )
        end

        return
    end

    if action ==
        "SaveSettings" then

        if Extra.SettingsStatus then

            Extra.SettingsStatus.Text =
                tostring(
                    message
                    or (
                        ok
                        and "SETTINGS SAVED"
                        or "SAVE FAILED"
                    )
                )
        end

        return
    end

    if action ==
        "SetAntiBring" then

        ProtectionStatus.Text =
            "Protection status: "
            .. tostring(
                message
                or (
                    State.AntiBring
                    and "ANTI BRING ON"
                    or "ANTI BRING OFF"
                )
