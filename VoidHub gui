teleportToVoid = function(
    targetPlayer,
    offsetX,
    offsetZ
)

    if not targetPlayer
        or not alive(
            targetPlayer
        ) then

        return false
    end

    local c =
        character(
            targetPlayer
        )

    local r =
        root(
            targetPlayer
        )

    local h =
        humanoid(
            targetPlayer
        )

    if not c
        or not r
        or not h then

        return false
    end

    local voidY =
        workspace.FallenPartsDestroyHeight
        + VOID_CLEARANCE

    local voidCFrame =
        CFrame.new(
            r.Position.X
                + (offsetX or 0),
            voidY,
            r.Position.Z
                + (offsetZ or 0)
        )

    setServerOwnership(
        targetPlayer,
        true
    )

    h.Sit =
        false

    h.PlatformStand =
        false

    h.AutoRotate =
        false

    h.WalkSpeed =
        0

    r.Anchored =
        true

    c:PivotTo(
        voidCFrame
    )

    zeroVelocity(
        targetPlayer
    )

    -- Hold them in void briefly
    task.delay(
        0.25,
        function()

            if targetPlayer
                and targetPlayer.Parent ==
                    Players then

                local currentRoot =
                    root(
                        targetPlayer
                    )

                local currentHumanoid =
                    humanoid(
                        targetPlayer
                    )

                if currentRoot then

                    currentRoot.Anchored =
                        false

