function Extra.repairPanel()

    if not State.PanelGuard then
        return false
    end

    local repaired =
        false

    local function ensure(
        object,
        propertyName,
        expectedValue
    )

        if not object then
            return
        end

        local ok,
            current =
            pcall(function()

                return object[
                    propertyName
                ]
            end)

        if ok
            and current ~=
                expectedValue then

            local setOk =
                pcall(function()

                    object[
                        propertyName
                    ] =
                        expectedValue
                end)

            if setOk then
                repaired =
                    true
            end
        end
    end

    ensure(
        Gui,
        "Parent",
        PlayerGui
    )

    ensure(
        Gui,
        "Enabled",
        true
    )

    ensure(
        Gui,
        "DisplayOrder",
        100000
    )

    ensure(
        Holder,
        "Parent",
        Gui
    )

    ensure(
        Main,
        "Parent",
        Holder
    )

    ensure(
        Shadow,
        "Parent",
        Holder
    )

    ensure(
        ResponsiveScale,
        "Parent",
        Holder
    )

    ensure(
        PanelScale,
        "Parent",
        Main
    )

    ensure(
        Sidebar,
        "Parent",
        Main
    )

    ensure(
        Content,
        "Parent",
        Main
    )

    ensure(
        Main,
        "Visible",
        true
    )

    ensure(
        Shadow,
        "Visible",
        true
    )

    if not PanelBusy then

        ensure(
            Holder,
            "Visible",
            PanelOpen
        )
    end

    if repaired then

        local now =
            os.clock()

        if now
            - (
                Extra.PanelGuardLastAlert
                or 0
            )
            > 2 then

            Extra.PanelGuardLastAlert =
                now

            pcall(function()

                StarterGui:SetCore(
                    "SendNotification",
                    {
                        Title =
                            "VOID HUB PANEL GUARD",

                        Text =
                            "Panel change blocked and repaired.",

                        Duration =
                            4
                    }
                )
            end)
        end
    end

    return repaired
end

