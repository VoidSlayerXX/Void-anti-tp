local function externalJointTouchesCharacter(
    object,
    char
)

    if object:IsA(
        "WeldConstraint"
    )
        or object:IsA(
            "Weld"
        )
        or object:IsA(
            "ManualWeld"
        )
        or object:IsA(
            "Motor6D"
        ) then

        local a =
            object.Part0

        local b =
            object.Part1

        if not a
            or not b then

            return false
        end

        local aIn =
            partInsideCharacter(
                a,
                char
            )

        local bIn =
            partInsideCharacter(
                b,
                char
            )

        return aIn ~= bIn
    end

    if object:IsA(
        "RopeConstraint"
    )
        or object:IsA(
            "RodConstraint"
        )
        or object:IsA(
            "SpringConstraint"
        )
        or object:IsA(
            "BallSocketConstraint"
        )
        or object:IsA(
            "HingeConstraint"
        )
        or object:IsA(
            "RigidConstraint"
        )
        or object:IsA(
            "CylindricalConstraint"
        )
        or object:IsA(
            "PrismaticConstraint"
        )
        or object:IsA(
            "AlignPosition"
        )
        or object:IsA(
            "AlignOrientation"
        ) then

        local a =
            object.Attachment0

        local b =
            object.Attachment1

        if not a
            or not b then

            return false
        end

        local aIn =
            attachmentInsideCharacter(
                a,
                char
            )

        local bIn =
            attachmentInsideCharacter(
                b,
                char
            )

        return aIn ~= bIn
    end

    return false
end

local function jointTouchesCharacter(
    object,
    char
)

    if not object
        or not char then

        return false
    end

    if object:IsA(
        "WeldConstraint"
    )
        or object:IsA(
            "Weld"
        )
        or object:IsA(
            "ManualWeld"
        )
        or object:IsA(
