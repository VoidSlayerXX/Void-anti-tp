                                false
                        end
                    end
                )
            end
        end
    )
end

function Extra.checkWatchPlayer(
    targetPlayer
)

    if not targetPlayer
        or targetPlayer == Player then

        return
    end

    local lowerName =
        string.lower(
            targetPlayer.Name
        )

    local exactWatch =
        Extra.WatchUsernames[
            lowerName
        ] == true

    local ogxWatch =
        Extra.playerHasOGxTag(
            targetPlayer
        )

    if not exactWatch
        and not ogxWatch then

        return
    end

    local key =
        tostring(
            targetPlayer.UserId
        )
        .. ":"
        .. tostring(
            exactWatch
        )
        .. ":"
        .. tostring(
            ogxWatch
        )

    if Extra.WatchSeen[
        key
    ] then

        return
    end

    Extra.WatchSeen[
        key
    ] =
        true

    if exactWatch
        and ogxWatch then

        Extra.showWatchAlert(
            "WATCH USER + OGx DETECTED • @"
            .. targetPlayer.Name
        )

    elseif exactWatch then

        Extra.showWatchAlert(
            "WATCH USER JOINED • @"
            .. targetPlayer.Name
        )

    else

        Extra.showWatchAlert(
            "OGx CLAN DETECTED • @"
            .. targetPlayer.Name
        )
    end
end

