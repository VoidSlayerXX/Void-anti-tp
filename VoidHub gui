function Extra.clientBringTarget()
    if not SelectedPlayer then return false end
    
    local myRoot = root()
    local targetRoot = root(SelectedPlayer)
    local targetHumanoid = humanoid(SelectedPlayer)
    
    if not myRoot or not targetRoot or not targetHumanoid then
        return false
    end
    
    if targetHumanoid.Health <= 0 then
        return false
    end
    
    -- Bring target right in front of me
    local bringPosition = myRoot.Position + myRoot.CFrame.LookVector * 5
    
    -- Teleport target
    targetRoot.CFrame = CFrame.new(bringPosition)
    
    -- Reset velocities
    targetRoot.AssemblyLinearVelocity = Vector3.zero
    targetRoot.Velocity = Vector3.zero
    
    -- Make target face me
    targetRoot.CFrame = CFrame.lookAt(targetRoot.Position, myRoot.Position)
    
    return true
end

function Extra.clientTrapInVoid()
    if not SelectedPlayer then return false end
    
    local targetRoot = root(SelectedPlayer)
    
    if not targetRoot then return false end
    
    -- Teleport target to void
    local voidPosition = Vector3.new(
        targetRoot.Position.X,
        workspace.FallenPartsDestroyHeight - 50,
        targetRoot.Position.Z
    )
    
    targetRoot.CFrame = CFrame.new(voidPosition)
    targetRoot.AssemblyLinearVelocity = Vector3.zero
    targetRoot.Velocity = Vector3.zero
    
    return true
end

