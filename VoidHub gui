--==============================================================
-- V10.4 ANTI GYM BAN
--==============================================================
-- For an experience you own/control. This does not bypass Roblox
-- moderation or another experience's server-side access controls.
-- Many vulnerable RP gym systems store a ban/blacklist as an
-- Attribute or ValueObject after a client fires an insecure remote.

local GymBanGuard = {
    Enabled = {},
    LastFixAt = {},
    LastNoticeAt = {}
}

local GYM_BAN_MARKERS = {
    gymban = true,
    gymbanned = true,
    bannedfromgym = true,
    gymblacklist = true,
    gymblacklisted = true,
    gymblocked = true,
    blockedfromgym = true,
    gymaccessblocked = true,
    gymaccessdenied = true,
    nogymaccess = true,
    cannotentergym = true,
    cantentergym = true
}

local function normalizeGymBanName(name)
    local lower = string.lower(tostring(name))
    return (string.gsub(lower, "[^%w]", ""))
end

local function looksLikeGymBanMarker(name)
    return GYM_BAN_MARKERS[normalizeGymBanName(name)] == true
end

local function hasAntiGymBan(player)
    return player and player:GetAttribute("VoidHubAntiGymBan") == true
end

local function clearGymBanAttributes(instance)
    if not instance then return 0 end
    local changed = 0
    for attributeName, value in pairs(instance:GetAttributes()) do
        if looksLikeGymBanMarker(attributeName) then
            local valueType = typeof(value)
            if valueType == "boolean" and value ~= false then
                instance:SetAttribute(attributeName, false)
                changed += 1
            elseif valueType == "number" and value ~= 0 then
                instance:SetAttribute(attributeName, 0)
                changed += 1
            elseif valueType == "string" and value ~= "" then
                instance:SetAttribute(attributeName, "")
                changed += 1
            end
        end
    end
    return changed
end

local function clearGymBanValueObject(object)
    if not object or not looksLikeGymBanMarker(object.Name) then return false end
    if object:IsA("BoolValue") then
        if object.Value ~= false then object.Value = false return true end
    elseif object:IsA("StringValue") then
        if object.Value ~= "" then object.Value = "" return true end
    elseif object:IsA("IntValue") or object:IsA("NumberValue") then
        if object.Value ~= 0 then object.Value = 0 return true end
    elseif object:IsA("ObjectValue") then
        if object.Value ~= nil then object.Value = nil return true end
    end
    return false
end

local function clearGymBanContainer(container)
    if not container then return 0 end
    local changed = clearGymBanAttributes(container)
    for _, object in ipairs(container:GetDescendants()) do
        changed += clearGymBanAttributes(object)
        if clearGymBanValueObject(object) then changed += 1 end
    end
    return changed
end

local function runAntiGymBan(player)
    if not player
        or player.Parent ~= Players
        or (
            not isAuthorized(player)
            and player:GetAttribute("VoidHubProtected") ~= true
        )
        or not hasAntiGymBan(player) then

        return false
    end
    local changed = clearGymBanContainer(player)
    local c = character(player)
    if c then changed += clearGymBanContainer(c) end
    if changed > 0 then
        local now = os.clock()
        GymBanGuard.LastFixAt[player] = now
        if now - (GymBanGuard.LastNoticeAt[player] or 0) >= 0.75 then
            GymBanGuard.LastNoticeAt[player] = now
            sendResult(player,"AntiGymBan",true,"ANTI GYM BAN • BLOCKED "..tostring(changed).." MARKER"..(changed == 1 and "" or "S"))
        end
        return true
    end
    return false
end

local function setAntiGymBan(player, enabled)
    if not player or not isAuthorized(player) then return false, "NOT AUTHORIZED" end
    local on = enabled == true
    local settings = settingsFor(player)
    settings.AntiGymBan = on
    player:SetAttribute("VoidHubAntiGymBan", on)
    GymBanGuard.Enabled[player] = on and true or nil
    if on then runAntiGymBan(player) end
    return true, on and "ANTI GYM BAN ON" or "ANTI GYM BAN OFF"
end

